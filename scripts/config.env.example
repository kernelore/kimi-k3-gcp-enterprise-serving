#!/usr/bin/env bash
# ==============================================================================
# Kimi K3 Sovereign Enterprise Inference Architecture - Environment Config Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this example file to create your active environment configuration:
#    cp scripts/config.env.example scripts/config.env
# 2. Edit scripts/config.env and replace the placeholder values below with your
#    own GCP Project ID, region, zone, and mandatory compliance labels.
# 3. Run ./scripts/01_setup_and_check.sh to initialize your environment.
# Note: Do NOT commit scripts/config.env to git/source control.
# ==============================================================================

# Required: GCP Project ID where the infrastructure and workloads will be deployed
export PROJECT_ID="YOUR_PROJECT_ID"

# GCP Region and Zone for Sovereign Deployment (Hamina, Finland recommended)
export REGION="europe-north1"
export ZONE="europe-north1-b" # Required zone for NVIDIA B200 and RoCEv2 network profile

# GKE Cluster and GPU Node Pool Configuration
export CLUSTER_NAME="kimi-enterprise-fi"
export GPU_MACHINE_TYPE="a4-highgpu-8g" # 8x NVIDIA B200 HGX per node (16x GPUs total across 2 nodes)
export GPU_MAX_NODES="2"                # Maximum node count for B200 Spot GPU autoscaling
export SERVING_REPLICAS="1"             # Number of multi-node serving replicas
export NODES_PER_REPLICA="2"            # Nodes per replica (2 nodes = 16x B200 GPUs in tandem over GPUDirect RDMA)

# Storage & Volume Configuration (2 TB Hyperdisk ML ReadOnlyMany volume for weights and compiled engine)
export HYPERDISK_ML_SIZE_GB="2000"

# Optional: Master Authorized CIDR for GKE Control Plane access
# If left empty (""), 01_setup_and_check.sh will auto-detect your public IP.
export MASTER_AUTHORIZED_CIDR=""


# Mandatory Resource Compliance Labels (ensure strict adherence to prevent cleanup)
export OWNER_LABEL="your-username-kimi3" # Lowercase alphanumeric and hyphens only
export TTL_LABEL="7d"                    # e.g., 24h, 7d, 14d
export ENV_LABEL="kimi-k3-prod"          # Sovereign production label for Kimi K3
export MODEL_FAMILY="kimi-k3"            # Target AI model family (kebab-case)

# GCS Remote State Bucket for Terraform (shared across team members)
# By default, scripts/01_setup_and_check.sh will automatically provision and version
# gs://${PROJECT_ID}-kimi-k3-tfstate for you.
export TF_STATE_BUCKET="YOUR_PROJECT_ID-kimi-k3-tfstate"

# Hugging Face Access Token (Required for downloading Moonshot AI Kimi K3 weights)
# You can obtain or generate a read-only token from: https://huggingface.co/settings/tokens
export HF_TOKEN="your_huggingface_access_token_here"

# Enterprise AI Gateway Master Key & Database Credentials
export GATEWAY_MASTER_KEY="sk-kimi-k3-master-secret-key-change-me"
export DB_PASSWORD=""

# Model & Serving Engine Configuration (Moonshot AI Kimi K3 2.8T MXFP4)
export MODEL_REPO_ID="moonshotai/Kimi-K3-2.8T-MXFP4"
export SERVING_MODEL_NAME="kimi-k3-2.8t-mxfp4"
export EXPECTED_MODEL_ARCHITECTURE=""   # DAY-0: set to architectures[0] from the released Kimi K3 config.json. Empty = denylist and size floor only.
export MIN_WEIGHTS_GIB="1000"           # Hard floor. Kimi K3 is ~1.4 TB; anything materially smaller is the wrong checkpoint.

# Master Inference Engine Selector (Primary Default: sglang, Experimental Option: trtllm)
export INFERENCE_ENGINE="${INFERENCE_ENGINE:-sglang}"

# NVIDIA TensorRT-LLM Multi-Node MPI Distributed Inference Parameters (Experimental Option)
export TRTLLM_TP_SIZE="8"               # Tensor Parallelism across 8 GPUs per node
export TRTLLM_PP_SIZE="2"               # Pipeline Parallelism across 2 nodes
export TRTLLM_EP_SIZE="8"               # Expert Parallelism across MoE experts
export TRTLLM_MAX_SEQ_LEN="131072"      # Maximum sequence length (prompt + outputs)

# SGLang Multi-Node Serving Configuration Parameters (Primary Default)
export SGLANG_PORT="8000"
export SGLANG_MEM_FRACTION_STATIC="0.90"
export SGLANG_TP_SIZE="16"
export SGLANG_PP_SIZE="1"
export SGLANG_PP_LAYER_PARTITION=""   # Comma-separated layers per PP stage; must sum to the model's layer count and have SGLANG_PP_SIZE elements. Leave empty for automatic even split. DAY-0: set only after reading num_hidden_layers from the released config.json.
export SGLANG_EP_SIZE="16"
export SGLANG_SCHEDULE_POLICY="lpm"
export SGLANG_ATTENTION_BACKEND=""
export SGLANG_ENABLE_TORCH_COMPILE="false"
export SGLANG_QUANTIZATION=""
export SGLANG_CONTEXT_LENGTH="131072"

# Mandatory RoCEv2 GPUDirect RDMA Settings & NCCL High-Performance Environment
# Required for 16x B200 HGX multi-node inter-communication over Jumbo Frame MTU 8896 and Compact Placement:

# Optional: Fast GCS Weight Cache Hydration & Lifecycle Management
# If set to an existing GCS path (e.g. gs://your-bucket/mxfp4), scripts/03_deploy_workloads.sh hydrates
# Hyperdisk ML directly from GCS, bypassing Hugging Face download.
export GCS_WEIGHTS_BUCKET=""
export POPULATE_WEIGHTS_CACHE="false"   # Set to "true" to seed GCS_WEIGHTS_BUCKET after HF download completes
export SKIP_WEIGHT_JOB="false"          # Set to "true" to skip weight staging job entirely
export FORCE_WEIGHT_JOB="false"         # Set to "true" to force recreating ROX disk in ReadWrite mode for restaging

# Teardown Configuration
export PURGE_WEIGHTS_CACHE="${PURGE_WEIGHTS_CACHE:-false}" # Set to "true" during destroy to purge GCS weight cache bucket
export FORCE_DESTROY="${FORCE_DESTROY:-false}"             # Set to "true" to skip confirmation prompt during 06_destroy_all.sh
