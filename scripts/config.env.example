#!/usr/bin/env bash
# ==============================================================================
# Kimi K3 Sovereign Enterprise Inference Architecture - Environment Config Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this example file to create your active environment configuration:
#    cp scripts/config.env.example scripts/config.env
# 2. Edit scripts/config.env and replace the placeholder values below with your
#    own GCP Project ID, region, zone, and mandatory compliance labels.
# 3. Run ./scripts/01_setup_and_check.sh to initialize your environment.
# Note: Do NOT commit scripts/config.env to git/source control.
# ==============================================================================

# Required: GCP Project ID where the infrastructure and workloads will be deployed
export PROJECT_ID="YOUR_PROJECT_ID"

# GCP Region and Zone for Sovereign Deployment (Hamina, Finland recommended)
export REGION="europe-north1"
export ZONE="europe-north1-b" # Required zone for NVIDIA B200 and RoCEv2 network profile

# GKE Cluster and GPU Node Pool Configuration
export CLUSTER_NAME="kimi-enterprise-fi"
export GPU_MACHINE_TYPE="a4-highgpu-8g" # 8x NVIDIA B200 HGX per node (16x GPUs total across 2 nodes)
export GPU_MAX_NODES="2"                # Maximum node count for B200 Spot GPU autoscaling
# Fixed multi-node serving replica architecture (1 replica = 2 nodes = 16x B200 GPUs):
# export SERVING_REPLICAS="1"
# export NODES_PER_REPLICA="2"

# Storage & Volume Configuration (2 TB Hyperdisk ML ReadOnlyMany volume for weights and compiled engine)
export HYPERDISK_ML_SIZE_GB="2000"
export HYPERDISK_ML_THROUGHPUT_MIBPS="24576" # Regional HDML throughput quota default (MiB/s); fallback 6144

export FABRIC_GATE_TIMEOUT_SECONDS="900" # Timeout in seconds for RoCEv2 fabric & parity checks (default: 900s)
export MASTER_AUTHORIZED_CIDR=""


# Mandatory Resource Compliance Labels (ensure strict adherence to prevent cleanup)
export OWNER_LABEL="your-username-kimi3" # Lowercase alphanumeric and hyphens only
export TTL_LABEL="7d"                    # e.g., 24h, 7d, 14d
export ENV_LABEL="kimi-k3-prod"          # Sovereign production label for Kimi K3
export MODEL_FAMILY="kimi-k3"            # Target AI model family (kebab-case)

# GCS Remote State Bucket for Terraform (shared across team members)
# By default, scripts/01_setup_and_check.sh will automatically provision and version
# gs://${PROJECT_ID}-kimi-k3-tfstate for you.
export TF_STATE_BUCKET="YOUR_PROJECT_ID-kimi-k3-tfstate"

# Hugging Face Access Token (Required for downloading Moonshot AI Kimi K3 weights)
# You can obtain or generate a read-only token from: https://huggingface.co/settings/tokens
export HF_TOKEN="your_huggingface_access_token_here"
export HF_TOKEN_BASE64=""                # Populated automatically by 03_deploy_workloads.sh

# Cloud SQL & Memorystore Redis Gateway Authentication Keys
# If left blank, 02_deploy_infra.sh will automatically generate high-entropy strings and sync to Secret Manager.
export GATEWAY_MASTER_KEY=""
export REDIS_PASSWORD=""
export DB_PASSWORD=""

# Model & Serving Engine Configuration (Moonshot AI Kimi K3 2.8T MXFP4)
export MODEL_REPO_ID="moonshotai/Kimi-K3"
export SERVING_MODEL_NAME="moonshotai/Kimi-K3"
export EXPECTED_MODEL_ARCHITECTURE="KimiK3ForConditionalGeneration"   # Verified against released checkpoint architectures[0] from https://huggingface.co/moonshotai/Kimi-K3/raw/main/config.json on 2026-07-31.
export MIN_WEIGHTS_GIB="1000"           # Hard floor. Kimi K3 is ~1.4 TB; anything materially smaller is the wrong checkpoint.

# Master Inference Engine Selector (Primary Default: sglang, Experimental Option: trtllm)
export INFERENCE_ENGINE="${INFERENCE_ENGINE:-sglang}"

# NVIDIA TensorRT-LLM Multi-Node MPI Distributed Inference Parameters (Experimental Option)
export TRTLLM_TP_SIZE="8"               # Tensor Parallelism across 8 GPUs per node
export TRTLLM_PP_SIZE="2"               # Pipeline Parallelism across 2 nodes
export TRTLLM_EP_SIZE="8"               # Expert Parallelism across MoE experts
export TRTLLM_MAX_SEQ_LEN="131072"      # Maximum sequence length (prompt + outputs)

# SGLang Multi-Node Serving Configuration Parameters (Primary Default)
# SGLANG_PORT is fixed to 8000 in Kubernetes Service, probes, and PodMonitoring:
# export SGLANG_PORT="8000"
export SGLANG_PARALLEL_PROFILE="${SGLANG_PARALLEL_PROFILE:-tp16}"          # Parallelism profile: tp16 (default TP16/PP1) or tp8pp2 (fallback TP8/PP2 over RoCEv2)
export SGLANG_MEM_FRACTION_STATIC="${SGLANG_MEM_FRACTION_STATIC:-0.85}"
export SGLANG_TP_SIZE="16"
export SGLANG_PP_SIZE="1"
export SGLANG_PP_LAYER_PARTITION=""   # Comma-separated layers per PP stage; must sum to num_hidden_layers=93 and have SGLANG_PP_SIZE elements. Leave empty for automatic split (uneven by construction for PP=2 since 93 is odd and MLA layers occur at every 4th layer plus the last; override via SGLANG_PP_LAYER_PARTITION once measured at first deployment).
export SGLANG_EP_SIZE="16"               # Expert Parallelism; SGLANG_PARALLEL_PROFILE=tp8pp2 overrides this to 8; SGLang requires ep_size to be 1 or equal to tp_size
export SGLANG_SCHEDULE_POLICY="lpm"
export SGLANG_CHUNKED_PREFILL_SIZE="${SGLANG_CHUNKED_PREFILL_SIZE:-}"   # Prefill chunk size in tokens. Empty = engine default. Lower (e.g. 4096) to interleave prefill with decode when TTFT P99 blows out under high concurrency at long ISL.
export SGLANG_MAX_RUNNING_REQUESTS="${SGLANG_MAX_RUNNING_REQUESTS:-}"  # Hard cap on concurrently running requests. Empty = engine default. Set to floor(max_total_num_tokens / (ISL+OSL)) to trade retraction for admission queueing.
export SGLANG_DISABLE_CUSTOM_ALL_REDUCE="${SGLANG_DISABLE_CUSTOM_ALL_REDUCE:-}"  # "true" routes intra-node all-reduce through NCCL instead of the custom kernel. Required for SGLANG_PARALLEL_PROFILE=tp8pp2, whose CUDA IPC graph-buffer registration fails during decode CUDA graph capture. Empty for TP16, which never takes that path.
export SGLANG_SPECULATIVE_ALGORITHM="${SGLANG_SPECULATIVE_ALGORITHM:-}"          # "DSPARK" enables speculative decoding per the Google Cloud day-0 recipe. Empty = no drafting (the published baseline).
export SGLANG_SPECULATIVE_DRAFT_MODEL_PATH="${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH:-/mnt/draft/Kimi-K3-DSpark}"  # Pod-local path the draft checkpoint is fetched to by the dspark-draft-fetch init container. Not on the ROX volume: that disk is READ_ONLY_MANY once hydrated.
export SGLANG_SPECULATIVE_DSPARK_BLOCK_SIZE="${SGLANG_SPECULATIVE_DSPARK_BLOCK_SIZE:-7}"      # Draft block size; 7 is the value the day-0 recipe pins.
export SGLANG_ENABLE_LINEAR_REPLAYSSM_SPEC="${SGLANG_ENABLE_LINEAR_REPLAYSSM_SPEC:-}"        # "true" adds --enable-linear-replayssm-spec, required by the recipe alongside DSPARK on the hybrid-attention K3.
export DSPARK_DRAFT_DIR_NAME="${DSPARK_DRAFT_DIR_NAME:-}"                                     # GCS prefix under GCS_WEIGHTS_BUCKET holding the draft checkpoint. Set to Kimi-K3-DSpark alongside SGLANG_SPECULATIVE_ALGORITHM. Empty skips the fetch entirely.
export SERVING_POD_SERVICE_ACCOUNT="${SERVING_POD_SERVICE_ACCOUNT:-default}"                  # KSA the serving pods run as. "default" has no cloud identity; set to kimi-k3-serving-sa when DSPARK is on, so the init container can read the draft from GCS.
# Kernel selection. Every value below is EMPTY on purpose: the SGLang Kimi-K3 cookbook's
# B200 / nnodes 2 cell -- our exact topology -- pins no attention backend, no MoE runner and
# no KV-cache dtype, and lets the engine dispatch for the hardware it finds.
# (https://docs.sglang.io/cookbook/autoregressive/Moonshotai/Kimi-K3)
# Kimi K3 interleaves 69 KDA linear-attention layers with 24 full-attention (MLA) layers, so
# if you do pin a backend, pin prefill and decode separately -- never with the combined
# --attention-backend flag, which sets the base for both phases at once.
export SGLANG_PREFILL_ATTENTION_BACKEND=""            # Prefill kernel for the 24 MLA layers; triton and fa4 are the Blackwell options
export SGLANG_DECODE_ATTENTION_BACKEND=""             # K3 is AttentionArch.MLA, and SGLang resolves MLA on Blackwell/SM100 to flashinfer. Do NOT set flashmla: the cookbook uses it only on H100/H200. Do NOT set trtllm_mha: that is the SM100 default for MHA architectures, which K3 is not.
export SGLANG_LINEAR_ATTN_PREFILL_BACKEND=""          # KDA prefill kernel for the 69 linear layers. cutedsl is the Blackwell CuteDSL kernel, admitted only for the MLA-hybrid family (K3/KimiLinear); engine default is triton.
export SGLANG_MOE_RUNNER_BACKEND=""                   # e.g. flashinfer_mxfp4, which also expects SGLANG_TRTLLM_GEN_MOE_CUBIN_POOL to point at a cubin pool; marlin is what the cookbook's Hopper cells use
export SGLANG_KV_CACHE_DTYPE=""                       # e.g. fp8_e4m3; an opt-in overlay in the cookbook playground, not part of the B200 cell

# Hierarchical (multi-tier) KV cache. OFF by default -- the published baseline is a
# single-tier HBM run. Turning it on adds a host-RAM tier and, with the "file" storage
# backend, a third tier on the node-local NVMe RAID that the a4-highgpu-8g nodes ship
# with (32 x 375 GB, striped into one XFS array by the local-nvme-raid-formatter
# DaemonSet and mounted at SGLANG_HOST_SCRATCH_PATH on the host).
#
# This only pays off for workloads that re-read prefixes larger than the HBM pool can
# hold -- long shared system prompts, multi-turn chat, document Q&A over one corpus. On
# a purely non-repetitive workload it is overhead, which is why it is opt-in and why it
# must be measured with a prefix-reuse benchmark rather than the saturation sweep.
#
# The launch wrapper refuses to start when this is "true" and the array is not mounted,
# rather than silently falling back to the boot disk and reporting plausible numbers.
export SGLANG_ENABLE_HIERARCHICAL_CACHE="false"
export SGLANG_HICACHE_STORAGE_BACKEND=""              # "" = host RAM only (two tiers). "file" adds the NVMe tier; also valid: hf3fs, mooncake, nixl, aibrix, eic, dynamic
export SGLANG_HICACHE_RATIO=""                        # Host-RAM tier size as a multiple of the HBM KV pool. Engine default 2.0. Ignored when SGLANG_HICACHE_SIZE is set.
export SGLANG_HICACHE_SIZE=""                         # Host-RAM tier size in GB, absolute. Takes precedence over SGLANG_HICACHE_RATIO. Engine default 0 (= use the ratio).
export SGLANG_HICACHE_WRITE_POLICY=""                 # write_through (engine default), write_through_selective, or write_back
export SGLANG_HICACHE_IO_BACKEND=""                   # kernel (engine default) or direct
export SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE=""        # Byte cap on the NVMe tier; "" = uncapped. Read by SGLang directly, not passed as a flag. Eviction starts at 90% of this.

# Node-local NVMe scratch. SGLANG_HOST_SCRATCH_PATH must match the mount point the
# local-nvme-raid-formatter DaemonSet creates (terraform/manifests/templates/
# 00-local-nvme-raid.yaml.template); change one and you must change the other.
#
# The node pool requests its local SSDs via local_nvme_ssd_block_config, which is BLOCK
# mode: the disks arrive as raw devices and are never registered as kubelet ephemeral
# storage. A disk-backed emptyDir therefore lands on the 200 GB boot disk, not on the
# ~12 TB array. Reaching the array requires a hostPath, which is what the serving pod
# uses for both the DSPARK draft and the hierarchical cache.
export SGLANG_HOST_SCRATCH_PATH="/mnt/disks/local-scratch"   # Path on the node, set by the DaemonSet
export SGLANG_LOCAL_SCRATCH_MOUNT="/mnt/scratch"             # Where that path appears inside the serving container

export SGLANG_ENABLE_TORCH_COMPILE="false"
export SGLANG_QUANTIZATION=""
export SGLANG_CONTEXT_LENGTH="131072"
export SGLANG_REASONING_PARSER="kimi_k3"          # Published SGLang cookbook (https://docs.sglang.io/cookbook/autoregressive/Moonshotai/Kimi-K3) prescribes kimi_k3 for lmsysorg/sglang:kimi-k3
export SGLANG_TOOL_CALL_PARSER="kimi_k3"          # Published SGLang cookbook (https://docs.sglang.io/cookbook/autoregressive/Moonshotai/Kimi-K3) prescribes kimi_k3 for lmsysorg/sglang:kimi-k3

# Mandatory RoCEv2 GPUDirect RDMA Settings & NCCL High-Performance Environment
# Required for 16x B200 HGX multi-node inter-communication over Jumbo Frame MTU 8896 and Compact Placement:

# Optional: Fast GCS Weight Backup Hydration & Lifecycle Management
# If set to an existing GCS bucket root (e.g. gs://YOUR_PROJECT_ID-kimi-k3-weights-backup), scripts/03_deploy_workloads.sh hydrates
# Hyperdisk ML directly from GCS, bypassing Hugging Face download.
export GCS_WEIGHTS_BUCKET=""
export POPULATE_WEIGHTS_CACHE="false"   # WARNING: Keep "false" when weights exist in GCS. Setting "true" bypasses GCS hydration (03_deploy_workloads.sh:420-423) and forces a full multi-hour HuggingFace re-download to re-seed GCS_WEIGHTS_BUCKET.
export SKIP_WEIGHT_JOB="false"          # Set to "true" to skip weight staging job entirely
export FORCE_WEIGHT_JOB="false"         # Set to "true" to force recreating ROX disk in ReadWrite mode for restaging

# Teardown Configuration
export PURGE_WEIGHTS_BACKUP="${PURGE_WEIGHTS_BACKUP:-false}" # Set to "true" alongside FORCE_DESTROY=true during destroy to purge GCS weight backup bucket
export FORCE_DESTROY="${FORCE_DESTROY:-false}"             # Set to "true" to skip confirmation prompt during 06_destroy_all.sh

# Optional: Prompt Sensitivity Sweep (scripts/05_run_benchmarks.sh --mode realistic)
# A diagnostic, not one of the five published suites, and deliberately excluded from
# --mode all. It runs every cell twice -- once on a repeated passage, once on a
# generated non-repetitive corpus -- at one matched input length, so the difference it
# reports is prompt predictability rather than prompt size.
#
# The headline number is accepted tokens per speculative verify step, which is derived
# from a counter delta. Without SWEEP_METRICS_ENDPOINT it is recorded as null and the
# run only tells you about throughput.
export REALISTIC_ISL_OSL_GRID=""          # e.g. "1536:1024" (default), or "1536:1024,8192:1024"
export REALISTIC_ARMS=""                  # e.g. "repeated_passage,non_repetitive" (default: both)
export REALISTIC_ISSUANCE=""              # "pool" (default, 2c requests through a c-wide pool) or "burst" (exactly c)
export REALISTIC_CORPUS_SEED=""           # Default 20260803. Changing it changes the published corpus; tests/test_realistic_corpus.py pins the default.
export REALISTIC_CORPUS_FILE=""           # Optional path to real prose; overrides the generated corpus
export REALISTIC_SPEC_VERIFY_METRIC=""    # Default "sglang:spec_verify_calls_total"

# Optional: Prefix Reuse Bench (scripts/05_run_benchmarks.sh --mode prefix-reuse)
# The other suites all inject a nonce to force a 0% prefix-cache hit rate; this one is
# the inverse, and is what decides whether SGLANG_ENABLE_HIERARCHICAL_CACHE and
# --schedule-policy lpm are worth turning on. It plots TTFT against shared-prefix
# length for a cold prefix, a GPU-resident one, and one deliberately evicted from the
# pool first, and reports 1 - slope_warm/slope_cold against the architectural bound.
# Also excluded from --mode all: it wants cache hits the published suites avoid.
#
# The evicted arm is the expensive one. It flushes the whole KV pool -- as prefill,
# which is billed -- once per sample, so the two budget knobs below are cost controls,
# not test tuning. Leave PREFIX_REUSE_KV_POOL_TOKENS empty to autodetect the pool from
# /get_server_info; the evicted arm is skipped, with the reason recorded, if neither
# the endpoint nor this var supplies a size.
export PREFIX_REUSE_ARMS=""               # e.g. "cold,warm" to skip the flush entirely (default: all four)
export PREFIX_REUSE_PREFIX_TOKENS=""      # Default "1024,4096,16384"; at least two lengths are needed to fit a slope
export PREFIX_REUSE_SUFFIX_TOKENS=""      # Default 256
export PREFIX_REUSE_REPEATS=""            # Default 4 samples per cold/warm point
export PREFIX_REUSE_EVICT_REPEATS=""      # Default 2 samples per evicted point
export PREFIX_REUSE_TARGET_HIT_RATE=""    # Default "0.5,0.8" for the concurrent mixed arm
export PREFIX_REUSE_KV_POOL_TOKENS=""     # Default: autodetect via /get_server_info
export PREFIX_REUSE_MAX_TOTAL_FLUSH=""    # Default 24000000 flush tokens for the whole run

# Optional: fp8 KV accuracy gate (scripts/05_run_benchmarks.sh --mode kv-accuracy)
# fp8_e4m3 roughly halves KV bytes and so roughly doubles the sequences that fit in the
# pool. It is the largest concurrency lever in the plan and the one change that can
# degrade output silently, so accuracy is settled before throughput is looked at.
#
# One invocation captures one configuration. A verdict needs three, in this order:
#   KV_ACCURACY_LABEL=bf16-a KV_ACCURACY_DTYPE=bfloat16  ... --mode kv-accuracy
#   KV_ACCURACY_LABEL=bf16-b KV_ACCURACY_DTYPE=bfloat16  ... --mode kv-accuracy
#   (flip the StatefulSet to fp8_e4m3, wait for Ready -- roughly a 17 minute warm restart)
#   KV_ACCURACY_LABEL=fp8    KV_ACCURACY_DTYPE=fp8_e4m3  ... --mode kv-accuracy
#   python3 benchmarks/kv_accuracy_gate.py compare --baseline ... --repeat ... --candidate ...
#
# The two bf16 runs are not redundant. A 2.8T MoE sharded over 16 GPUs is not
# bit-deterministic, so two identical configurations already disagree; without that
# floor a text diff measures nondeterminism and reports it as quantisation error.
export KV_ACCURACY_LABEL=""               # Required for --mode kv-accuracy. Names the capture; also names the output file.
export KV_ACCURACY_DTYPE=""               # The dtype the server is actually running. Recorded, not set -- so a comparison cannot silently compare a config against itself.
export KV_ACCURACY_CONTEXT_TOKENS=""      # Default 8192. KV error accumulates with distance, so this is the sensitivity knob.
export KV_ACCURACY_DEPTHS=""              # Default "0.05,0.25,0.50,0.75,0.95" needle depths through the context
export KV_ACCURACY_PROBES_PER_DEPTH=""    # Default 10, giving 50 probes across the five depths
export KV_ACCURACY_MAX_TOKENS=""          # Default 256 at temperature 0
export KV_ACCURACY_CORPUS_SEED=""         # Default 20260803. All three captures must share it or compare refuses them.

# Optional: shared sweep controls (--mode saturation, --mode realistic, --mode prefix-reuse)
# All four are read by --mode saturation and --mode realistic. --mode prefix-reuse reads
# only SWEEP_METRICS_ENDPOINT; it sizes its own arms from the PREFIX_REUSE_* vars above,
# because its concurrency is fixed by the cold/warm/evicted arm structure rather than swept.
# These were settable but undocumented, which made the recorded c=16 results hard to
# reproduce: nothing in this file said how a c=16 cell came to exist, since the saturation
# harness defaults to 1,8,32,128 and has no c=16 at all.
#
# c=16 provenance. Every recorded c=16 cell -- saturation_c16_direct.json,
# saturation_dspark_direct.json, saturation_tp8pp2_direct.json -- was produced with
# SWEEP_CONCURRENCY_LEVELS=8,16,32 and SWEEP_MAX_INFLIGHT=265000, and each file records
# both back as grid.sweep_levels and grid.MAX_INFLIGHT_PROMPT_TOKENS. That cap is also
# why those files have no 32k/2k cell at c=16 or c=32: 32768 x 16 = 524,288 in-flight
# prompt tokens exceeds 265,000, so the harness declined them before issuing a request.
# Raising the cap is what would fill those cells in; it is not a question of GPU hours.
#
# c=16 also matters going forward. scripts/07_run_tuning_sweep.sh anchors the
# pre-registered keep/back-out rule there, and refuses to start if the levels below
# would not produce it -- an undecidable sweep costs the same GPU time as a decidable
# one. The realistic harness already defaults to 8,16,32, so leaving these empty is
# correct for the tuning sweep; set them explicitly only to reproduce a saturation run.
export SWEEP_CONCURRENCY_LEVELS=""        # e.g. "8,16,32". Empty = per-harness default (saturation 1,8,32,128; realistic 8,16,32)
export SWEEP_MAX_INFLIGHT=""              # In-flight prompt-token ceiling; cells above it are skipped with the arithmetic recorded. Empty = harness default
export SWEEP_METRICS_ENDPOINT=""          # Prometheus /metrics on the engine. Required for accepted-tokens-per-verify-step; recorded as null without it
export SWEEP_METRICS_NAMES=""             # Extra counter names to snapshot either side of each cell
