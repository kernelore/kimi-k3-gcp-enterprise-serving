#!/usr/bin/env bash
# ==============================================================================
# Kimi K3 Sovereign Enterprise Inference Architecture - Environment Config Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this example file to create your active environment configuration:
#    cp scripts/config.env.example scripts/config.env
# 2. Edit scripts/config.env and replace the placeholder values below with your
#    own GCP Project ID, region, zone, and mandatory compliance labels.
# 3. Run ./scripts/01_setup_and_check.sh to initialize your environment.
# Note: Do NOT commit scripts/config.env to git/source control.
# ==============================================================================

# Required: GCP Project ID where the infrastructure and workloads will be deployed
export PROJECT_ID="YOUR_PROJECT_ID"

# GCP Region and Zone for Sovereign Deployment (Hamina, Finland recommended)
export REGION="europe-north1"
export ZONE="europe-north1-b" # Required zone for NVIDIA B200 and RoCEv2 network profile

# GKE Cluster and GPU Node Pool Configuration
export CLUSTER_NAME="kimi-enterprise-fi"
export GPU_MACHINE_TYPE="a4-highgpu-8g" # 8x NVIDIA B200 HGX per node (16x GPUs total across 2 nodes)
export GPU_MAX_NODES="2"                # Maximum node count for B200 Spot GPU autoscaling
# Fixed multi-node serving replica architecture (1 replica = 2 nodes = 16x B200 GPUs):
# export SERVING_REPLICAS="1"
# export NODES_PER_REPLICA="2"

# Storage & Volume Configuration (2 TB Hyperdisk ML ReadOnlyMany volume for weights and compiled engine)
export HYPERDISK_ML_SIZE_GB="2000"
export HYPERDISK_ML_THROUGHPUT_MIBPS="24576" # Regional HDML throughput quota default (MiB/s); fallback 6144

export FABRIC_GATE_TIMEOUT_SECONDS="900" # Timeout in seconds for RoCEv2 fabric & parity checks (default: 900s)
export MASTER_AUTHORIZED_CIDR=""


# Mandatory Resource Compliance Labels (ensure strict adherence to prevent cleanup)
export OWNER_LABEL="your-username-kimi3" # Lowercase alphanumeric and hyphens only
export TTL_LABEL="7d"                    # e.g., 24h, 7d, 14d
export ENV_LABEL="kimi-k3-prod"          # Sovereign production label for Kimi K3
export MODEL_FAMILY="kimi-k3"            # Target AI model family (kebab-case)

# GCS Remote State Bucket for Terraform (shared across team members)
# By default, scripts/01_setup_and_check.sh will automatically provision and version
# gs://${PROJECT_ID}-kimi-k3-tfstate for you.
export TF_STATE_BUCKET="YOUR_PROJECT_ID-kimi-k3-tfstate"

# Hugging Face Access Token (Required for downloading Moonshot AI Kimi K3 weights)
# You can obtain or generate a read-only token from: https://huggingface.co/settings/tokens
export HF_TOKEN="your_huggingface_access_token_here"
export HF_TOKEN_BASE64=""                # Populated automatically by 03_deploy_workloads.sh

# Cloud SQL & Memorystore Redis Gateway Authentication Keys
# If left blank, 02_deploy_infra.sh will automatically generate high-entropy strings and sync to Secret Manager.
export GATEWAY_MASTER_KEY=""
export REDIS_PASSWORD=""
export DB_PASSWORD=""

# Model & Serving Engine Configuration (Moonshot AI Kimi K3 2.8T MXFP4)
export MODEL_REPO_ID="moonshotai/Kimi-K3"
export SERVING_MODEL_NAME="moonshotai/Kimi-K3"
export EXPECTED_MODEL_ARCHITECTURE="KimiK3ForConditionalGeneration"   # Verified against released checkpoint architectures[0] from https://huggingface.co/moonshotai/Kimi-K3/raw/main/config.json on 2026-07-31.
export MIN_WEIGHTS_GIB="1000"           # Hard floor. Kimi K3 is ~1.4 TB; anything materially smaller is the wrong checkpoint.

# Master Inference Engine Selector (Primary Default: sglang, Experimental Option: trtllm)
export INFERENCE_ENGINE="${INFERENCE_ENGINE:-sglang}"

# NVIDIA TensorRT-LLM Multi-Node MPI Distributed Inference Parameters (Experimental Option)
export TRTLLM_TP_SIZE="8"               # Tensor Parallelism across 8 GPUs per node
export TRTLLM_PP_SIZE="2"               # Pipeline Parallelism across 2 nodes
export TRTLLM_EP_SIZE="8"               # Expert Parallelism across MoE experts
export TRTLLM_MAX_SEQ_LEN="131072"      # Maximum sequence length (prompt + outputs)

# SGLang Multi-Node Serving Configuration Parameters (Primary Default)
# SGLANG_PORT is fixed to 8000 in Kubernetes Service, probes, and PodMonitoring:
# export SGLANG_PORT="8000"
export SGLANG_PARALLEL_PROFILE="${SGLANG_PARALLEL_PROFILE:-tp16}"          # Parallelism profile: tp16 (default TP16/PP1) or tp8pp2 (fallback TP8/PP2 over RoCEv2)
export SGLANG_MEM_FRACTION_STATIC="${SGLANG_MEM_FRACTION_STATIC:-0.85}"
export SGLANG_TP_SIZE="16"
export SGLANG_PP_SIZE="1"
export SGLANG_PP_LAYER_PARTITION=""   # Comma-separated layers per PP stage; must sum to num_hidden_layers=93 and have SGLANG_PP_SIZE elements. Leave empty for automatic split (uneven by construction for PP=2 since 93 is odd and MLA layers occur at every 4th layer plus the last; override via SGLANG_PP_LAYER_PARTITION once measured at first deployment).
export SGLANG_EP_SIZE="16"               # Expert Parallelism; SGLANG_PARALLEL_PROFILE=tp8pp2 overrides this to 8; SGLang requires ep_size to be 1 or equal to tp_size
export SGLANG_SCHEDULE_POLICY="lpm"
export SGLANG_CHUNKED_PREFILL_SIZE="${SGLANG_CHUNKED_PREFILL_SIZE:-}"   # Prefill chunk size in tokens. Empty = engine default. Lower (e.g. 4096) to interleave prefill with decode when TTFT P99 blows out under high concurrency at long ISL.
export SGLANG_MAX_RUNNING_REQUESTS="${SGLANG_MAX_RUNNING_REQUESTS:-}"  # Hard cap on concurrently running requests. Empty = engine default. Set to floor(max_total_num_tokens / (ISL+OSL)) to trade retraction for admission queueing.
# Kernel selection. Every value below is EMPTY on purpose: the SGLang Kimi-K3 cookbook's
# B200 / nnodes 2 cell -- our exact topology -- pins no attention backend, no MoE runner and
# no KV-cache dtype, and lets the engine dispatch for the hardware it finds.
# (https://docs.sglang.io/cookbook/autoregressive/Moonshotai/Kimi-K3)
# Kimi K3 interleaves 69 KDA linear-attention layers with 24 full-attention (MLA) layers, so
# if you do pin a backend, pin prefill and decode separately -- never with the combined
# --attention-backend flag, which sets the base for both phases at once.
export SGLANG_PREFILL_ATTENTION_BACKEND=""            # Prefill kernel for the 24 MLA layers; triton and fa4 are the Blackwell options
export SGLANG_DECODE_ATTENTION_BACKEND=""             # K3 is AttentionArch.MLA, and SGLang resolves MLA on Blackwell/SM100 to flashinfer. Do NOT set flashmla: the cookbook uses it only on H100/H200. Do NOT set trtllm_mha: that is the SM100 default for MHA architectures, which K3 is not.
export SGLANG_LINEAR_ATTN_PREFILL_BACKEND=""          # KDA prefill kernel for the 69 linear layers. cutedsl is the Blackwell CuteDSL kernel, admitted only for the MLA-hybrid family (K3/KimiLinear); engine default is triton.
export SGLANG_MOE_RUNNER_BACKEND=""                   # e.g. flashinfer_mxfp4, which also expects SGLANG_TRTLLM_GEN_MOE_CUBIN_POOL to point at a cubin pool; marlin is what the cookbook's Hopper cells use
export SGLANG_KV_CACHE_DTYPE=""                       # e.g. fp8_e4m3; an opt-in overlay in the cookbook playground, not part of the B200 cell
export SGLANG_ENABLE_TORCH_COMPILE="false"
export SGLANG_QUANTIZATION=""
export SGLANG_CONTEXT_LENGTH="131072"
export SGLANG_REASONING_PARSER="kimi_k3"          # Published SGLang cookbook (https://docs.sglang.io/cookbook/autoregressive/Moonshotai/Kimi-K3) prescribes kimi_k3 for lmsysorg/sglang:kimi-k3
export SGLANG_TOOL_CALL_PARSER="kimi_k3"          # Published SGLang cookbook (https://docs.sglang.io/cookbook/autoregressive/Moonshotai/Kimi-K3) prescribes kimi_k3 for lmsysorg/sglang:kimi-k3

# Mandatory RoCEv2 GPUDirect RDMA Settings & NCCL High-Performance Environment
# Required for 16x B200 HGX multi-node inter-communication over Jumbo Frame MTU 8896 and Compact Placement:

# Optional: Fast GCS Weight Backup Hydration & Lifecycle Management
# If set to an existing GCS bucket root (e.g. gs://YOUR_PROJECT_ID-kimi-k3-weights-backup), scripts/03_deploy_workloads.sh hydrates
# Hyperdisk ML directly from GCS, bypassing Hugging Face download.
export GCS_WEIGHTS_BUCKET=""
export POPULATE_WEIGHTS_CACHE="false"   # WARNING: Keep "false" when weights exist in GCS. Setting "true" bypasses GCS hydration (03_deploy_workloads.sh:420-423) and forces a full multi-hour HuggingFace re-download to re-seed GCS_WEIGHTS_BUCKET.
export SKIP_WEIGHT_JOB="false"          # Set to "true" to skip weight staging job entirely
export FORCE_WEIGHT_JOB="false"         # Set to "true" to force recreating ROX disk in ReadWrite mode for restaging

# Teardown Configuration
export PURGE_WEIGHTS_BACKUP="${PURGE_WEIGHTS_BACKUP:-false}" # Set to "true" alongside FORCE_DESTROY=true during destroy to purge GCS weight backup bucket
export FORCE_DESTROY="${FORCE_DESTROY:-false}"             # Set to "true" to skip confirmation prompt during 06_destroy_all.sh
