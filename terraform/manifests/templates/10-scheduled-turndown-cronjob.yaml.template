apiVersion: v1
kind: ServiceAccount
metadata:
  name: scheduled-turndown-sa
  namespace: llm-serving
  labels:
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: scheduled-turndown-role
  namespace: llm-serving
  labels:
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
rules:
- apiGroups: ["apps"]
  resources: ["statefulsets", "deployments", "statefulsets/scale", "deployments/scale"]
  verbs: ["get", "list", "patch", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: scheduled-turndown-rb
  namespace: llm-serving
  labels:
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
subjects:
- kind: ServiceAccount
  name: scheduled-turndown-sa
  namespace: llm-serving
roleRef:
  kind: Role
  name: scheduled-turndown-role
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: kimi-k3-turndown-evening
  namespace: llm-serving
  labels:
    app: kimi-k3-scheduled-turndown
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
spec:
  schedule: "0 19 * * 1-5"
  timeZone: "Europe/Helsinki"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app: kimi-k3-scheduled-turndown
        spec:
          serviceAccountName: scheduled-turndown-sa
          restartPolicy: OnFailure
          containers:
          - name: kubectl-turndown
            image: google/cloud-sdk:500.0.0-slim
            command:
            - "/bin/sh"
            - "-c"
            - "kubectl scale statefulset kimi-k3-serving --replicas=0 -n llm-serving"
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: kimi-k3-turndown-morning
  namespace: llm-serving
  labels:
    app: kimi-k3-scheduled-turndown
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
spec:
  schedule: "0 9 * * 1-5"
  timeZone: "Europe/Helsinki"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app: kimi-k3-scheduled-turndown
        spec:
          serviceAccountName: scheduled-turndown-sa
          restartPolicy: OnFailure
          containers:
          - name: kubectl-turnup
            image: google/cloud-sdk:500.0.0-slim
            command:
            - "/bin/sh"
            - "-c"
            - "kubectl scale statefulset kimi-k3-serving --replicas=${NODES_PER_REPLICA} -n llm-serving"
