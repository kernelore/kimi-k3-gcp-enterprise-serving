apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: nccl-gib-installer
  namespace: kube-system
  labels:
    app: nccl-gib-installer
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
spec:
  selector:
    matchLabels:
      app: nccl-gib-installer
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        app: nccl-gib-installer
        env: ${ENV_LABEL}
        owner: ${OWNER_LABEL}
    spec:
      hostNetwork: true
      hostPID: true
      nodeSelector:
        cloud.google.com/gke-accelerator: nvidia-b200
      tolerations:
      - key: "nvidia.com/gpu"
        operator: "Exists"
        effect: "NoSchedule"
      - key: "cloud.google.com/gke-spot"
        operator: "Exists"
        effect: "NoSchedule"
      initContainers:
      - name: nccl-gib-installer
        image: us-docker.pkg.dev/gce-ai-infra/gpudirect-gib/nccl-plugin-gib@sha256:cbfa66be797501a877e7e5a0222a8a778b5a297ef85ebda3ab3be15f1fbc06df
        securityContext:
          privileged: true
        command: ["/bin/sh", "-c"]
        args:
        - |
          set -ex
          /scripts/container_entry.sh install --install-nccl
          mkdir -p /mnt/host/nvidia/lib64 /mnt/host/gib
          cp -r /var/lib/gib/lib64/. /mnt/host/nvidia/lib64 2>/dev/null || cp -r /var/lib/gib/lib/. /mnt/host/nvidia/lib64 2>/dev/null || true
          cp -r /var/lib/gib/. /mnt/host/gib
          echo "installation finishes"
        volumeMounts:
        - name: nvidia-dir
          mountPath: /mnt/host/nvidia
        - name: gib-dir
          mountPath: /mnt/host/gib
      containers:
      - name: pause
        image: gke.gcr.io/pause:3.8@sha256:880e63f94b145e46f1b1082bb71b85e21f16b99b180b9996407d61240ceb9830
      volumes:
      - name: nvidia-dir
        hostPath:
          path: /home/kubernetes/bin/nvidia
          type: DirectoryOrCreate
      - name: gib-dir
        hostPath:
          path: /home/kubernetes/bin/gib
          type: DirectoryOrCreate
