apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: high-priority-serving
value: 1000000000
globalDefault: false
description: "High priority class for Kimi K3 serving pods to avoid preemption"
---
apiVersion: v1
kind: Secret
metadata:
  name: kimi-k3-ssh-secret
  namespace: llm-serving
type: Opaque
data:
  id_rsa: ${SSH_PRIVATE_KEY_BASE64}
  id_rsa.pub: ${SSH_PUBLIC_KEY_BASE64}
  authorized_keys: ${SSH_PUBLIC_KEY_BASE64}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: pv-kimi-k3-weights-rox
spec:
  storageClassName: ""
  capacity:
    storage: ${HYPERDISK_ML_SIZE_GB}Gi
  accessModes:
    - ReadOnlyMany
  mountOptions:
    - nouuid
    - ro
    - norecovery
  csi:
    driver: pd.csi.storage.gke.io
    volumeHandle: projects/${PROJECT_ID}/zones/${ZONE}/disks/kimi-k3-weights-rox
    fsType: xfs
    readOnly: true
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pvc-kimi-k3-weights-rox
  namespace: llm-serving
spec:
  storageClassName: ""
  volumeName: pv-kimi-k3-weights-rox
  accessModes:
    - ReadOnlyMany
  resources:
    requests:
      storage: ${HYPERDISK_ML_SIZE_GB}Gi
---
apiVersion: v1
kind: Service
metadata:
  name: kimi-k3-workers-headless
  namespace: llm-serving
spec:
  clusterIP: None
  publishNotReadyAddresses: true
  selector:
    app: kimi-k3-serving
  ports:
  - port: 2222
    name: mpi-ring
---
apiVersion: v1
kind: Service
metadata:
  name: kimi-k3-serving-svc
  namespace: llm-serving
  annotations:
    networking.gke.io/load-balancer-type: "Internal"
spec:
  type: LoadBalancer
  ports:
  - port: 8000
    targetPort: 8000
    name: http-api
  selector:
    app: kimi-k3-serving
    apps.kubernetes.io/pod-index: "0"
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: kimi-k3-serving
  namespace: llm-serving
spec:
  replicas: ${NODES_PER_REPLICA}
  serviceName: kimi-k3-workers-headless
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: kimi-k3-serving
  template:
    metadata:
      labels:
        app: kimi-k3-serving
        engine: trtllm
      annotations:
        networking.gke.io/default-interface: 'eth0'
        networking.gke.io/interfaces: |
          [
            {"interfaceName":"eth0","network":"default"},
            {"interfaceName":"eth2","network":"rdma-0"},
            {"interfaceName":"eth3","network":"rdma-1"},
            {"interfaceName":"eth4","network":"rdma-2"},
            {"interfaceName":"eth5","network":"rdma-3"},
            {"interfaceName":"eth6","network":"rdma-4"},
            {"interfaceName":"eth7","network":"rdma-5"},
            {"interfaceName":"eth8","network":"rdma-6"},
            {"interfaceName":"eth9","network":"rdma-7"}
          ]
    spec:
      priorityClassName: high-priority-serving
      terminationGracePeriodSeconds: 120
      nodeSelector:
        cloud.google.com/gke-accelerator: nvidia-b200
        cloud.google.com/gke-spot: "true"
      tolerations:
      - key: "nvidia.com/gpu"
        operator: "Exists"
        effect: "NoSchedule"
      - key: "cloud.google.com/gke-spot"
        operator: "Exists"
        effect: "NoSchedule"
      containers:
      - name: trtllm-mpi-node
        image: ${SERVING_IMAGE}
        env:
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: POD_INDEX
          valueFrom:
            fieldRef:
              fieldPath: metadata.labels['apps.kubernetes.io/pod-index']
        - name: LD_LIBRARY_PATH
          value: "/usr/local/nvidia/lib64:/usr/local/gib/lib64:/usr/local/nvidia/lib:/usr/local/gib/lib"
        - name: NCCL_CONF_FILE
          value: "/usr/local/gib/scripts/nccl.conf"
        - name: NCCL_DEBUG
          value: "INFO"
        - name: NCCL_DEBUG_SUBSYS
          value: "INIT,NET,GRAPH"
        - name: NCCL_SOCKET_IFNAME
          value: "eth0"
        - name: NCCL_NET_GDR_LEVEL
          value: "5"
        - name: MIN_WEIGHTS_GIB
          value: "${MIN_WEIGHTS_GIB}"
        - name: EXPECTED_MODEL_ARCHITECTURE
          value: "${EXPECTED_MODEL_ARCHITECTURE}"
        securityContext:
          capabilities:
            add:
            - IPC_LOCK
        startupProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "if [ \"$${HOSTNAME##*-}\" = \"0\" ]; then curl -sf http://localhost:8000/health; else pgrep -f \"sshd.*2222\" >/dev/null; fi"
          periodSeconds: 30
          failureThreshold: 120
          timeoutSeconds: 10
        readinessProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "if [ \"$${HOSTNAME##*-}\" = \"0\" ]; then curl -sf http://localhost:8000/health; else pgrep -f \"sshd.*2222\" >/dev/null; fi"
          periodSeconds: 15
          failureThreshold: 4
          timeoutSeconds: 5
        livenessProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "if [ \"$${HOSTNAME##*-}\" = \"0\" ]; then pgrep -f trtllm-serve >/dev/null; else pgrep -f \"sshd.*2222\" >/dev/null; fi"
          periodSeconds: 60
          failureThreshold: 10
          timeoutSeconds: 5
        lifecycle:
          preStop:
            exec:
              command: ["/bin/sh", "-c", "sleep 20"]
        command: ["/bin/bash", "-c"]
        args:
        - |
          set -euo pipefail
          if [ ! -r /usr/local/gib/scripts/set_nccl_env.sh ]; then
            echo "FATAL: gIB NCCL env script not readable at /usr/local/gib/scripts/set_nccl_env.sh." >&2
            echo "FATAL: Refusing to start — NCCL would silently fall back to TCP sockets (~50x bandwidth loss)." >&2
            exit 1
          fi
          source /usr/local/gib/scripts/set_nccl_env.sh
          echo "--- Resolved NCCL environment ---"
          env | grep -E '^NCCL_' | sort
          echo "---------------------------------"
          if [ -d /etc/secret-ssh ] && [ -f /etc/secret-ssh/id_rsa ]; then
            mkdir -p /root/.ssh
            cp /etc/secret-ssh/id_rsa /root/.ssh/id_rsa
            cp /etc/secret-ssh/authorized_keys /root/.ssh/authorized_keys
            chmod 700 /root/.ssh
            chmod 600 /root/.ssh/id_rsa /root/.ssh/authorized_keys
          fi
          python3 -c "
          import os, glob, json, sys
          dest = '/mnt/rox/Kimi-K3-2.8T-MXFP4'
          shards = glob.glob(os.path.join(dest, '*.safetensors'))
          total_size = sum(os.path.getsize(f) for f in shards)
          min_gib = float(os.getenv('MIN_WEIGHTS_GIB', '1000'))
          total_gib = total_size / (1024**3)
          if total_gib < min_gib:
              print(f'FATAL: Total weight size {total_gib:.2f} GiB in {dest} is below required floor MIN_WEIGHTS_GIB={min_gib:.2f} GiB.', file=sys.stderr)
              sys.exit(1)
          cfg_path = os.path.join(dest, 'config.json')
          if os.path.isfile(cfg_path):
              with open(cfg_path, 'r') as f:
                  cfg = json.load(f)
              archs = cfg.get('architectures', ['Unknown'])
              arch = archs[0] if archs else 'Unknown'
              mtype = cfg.get('model_type', 'unknown')
              layers = cfg.get('num_hidden_layers', 'unknown')
              n_exp = cfg.get('n_routed_experts', cfg.get('num_local_experts', 'unknown'))
              print(f'=== MODEL PROVENANCE GATE ===\nArchitectures: {archs}\nModel Type: {mtype}\nHidden Layers: {layers}\nExperts: {n_exp}\n=============================')
              denylist = ['GlmMoeDsaForCausalLM', 'Glm4MoeForCausalLM', 'DeepseekV3ForCausalLM', 'DeepseekV32ForCausalLM']
              if arch in denylist:
                  print(f'FATAL: Model architecture {arch} is in the known-wrong denylist. Refusing to start.', file=sys.stderr)
                  sys.exit(1)
              expected_arch = os.getenv('EXPECTED_MODEL_ARCHITECTURE', '')
              if expected_arch and arch != expected_arch:
                  print(f'FATAL: Found architecture {arch} but EXPECTED_MODEL_ARCHITECTURE={expected_arch}.', file=sys.stderr)
                  sys.exit(1)
          else:
              print(f'FATAL: config.json not found in {dest}; cannot verify model architecture.', file=sys.stderr)
              sys.exit(1)
          "
          echo "Populating peer short hostnames in /etc/hosts..."
          while ! getent hosts kimi-k3-serving-0.kimi-k3-workers-headless.llm-serving.svc.cluster.local >/dev/null || ! getent hosts kimi-k3-serving-1.kimi-k3-workers-headless.llm-serving.svc.cluster.local >/dev/null; do
            echo "Waiting for peer DNS A-records..."
            sleep 2
          done
          IP0=$(getent hosts kimi-k3-serving-0.kimi-k3-workers-headless.llm-serving.svc.cluster.local | awk '{print $1}')
          IP1=$(getent hosts kimi-k3-serving-1.kimi-k3-workers-headless.llm-serving.svc.cluster.local | awk '{print $1}')
          echo -e "$${IP0}\tkimi-k3-serving-0\n$${IP1}\tkimi-k3-serving-1" >> /etc/hosts
          cat /etc/hosts | tail -n 2
          NODE_RANK=$${POD_INDEX:-$${HOSTNAME##*-}}
          if [ "$${NODE_RANK}" = "0" ]; then
            echo "Waiting for worker sshd on port 2222..."
            while ! nc -z -w 2 kimi-k3-serving-1 2222 >/dev/null 2>&1; do
              echo "Waiting for kimi-k3-serving-1:2222..."
              sleep 2
            done
            echo "Worker sshd is ready on port 2222."
            echo -e "kimi-k3-serving-0.kimi-k3-workers-headless.llm-serving.svc.cluster.local slots=8\nkimi-k3-serving-1.kimi-k3-workers-headless.llm-serving.svc.cluster.local slots=8" > /tmp/hostfile
            echo "Starting TRT-LLM MPI leader node rank 0. Launching mpirun across 16 GPUs..."
            NCCL_XARGS=""
            for v in $(env | grep -E '^NCCL_' | cut -d= -f1 | sort); do
              NCCL_XARGS="$${NCCL_XARGS} -x $${v}"
            done
            echo "Forwarding to MPI ranks:$${NCCL_XARGS}"
            exec mpirun -n 16 --allow-run-as-root --hostfile /tmp/hostfile \
              --mca plm_rsh_args "-p 2222" \
              $${NCCL_XARGS} -x LD_LIBRARY_PATH -x PATH \
              trtllm-llmapi-launch trtllm-serve /mnt/rox/Kimi-K3-2.8T-MXFP4 \
                --backend pytorch --host 0.0.0.0 --port 8000 \
                --served-model-name "${SERVING_MODEL_NAME}" \
                --tp_size "${TRTLLM_TP_SIZE}" --pp_size "${TRTLLM_PP_SIZE}" --ep_size "${TRTLLM_EP_SIZE}" \
                --max_seq_len "${TRTLLM_MAX_SEQ_LEN}" \
                --kv_cache_free_gpu_memory_fraction 0.90 \
                --trust_remote_code
          else
            echo "Starting TRT-LLM worker node rank $${NODE_RANK}. Waiting for MPI leader connection on port 2222..."
            exec /usr/sbin/sshd -D -p 2222
          fi
        ports:
        - containerPort: 8000
          name: http
        volumeMounts:
        - name: model-rox
          mountPath: /mnt/rox
          readOnly: true
        - name: dshm
          mountPath: /dev/shm
        - name: nvidia-dir
          mountPath: /usr/local/nvidia
          readOnly: true
        - name: gib-dir
          mountPath: /usr/local/gib
          readOnly: true
        - name: secret-ssh
          mountPath: /etc/secret-ssh
          readOnly: true
        resources:
          requests:
            cpu: "32"
            memory: "512Gi"
          limits:
            memory: "512Gi"
            nvidia.com/gpu: 8
      volumes:
      - name: model-rox
        persistentVolumeClaim:
          claimName: pvc-kimi-k3-weights-rox
      - name: dshm
        emptyDir:
          medium: Memory
          sizeLimit: 512Gi
      - name: nvidia-dir
        hostPath:
          path: /home/kubernetes/bin/nvidia
      - name: gib-dir
        hostPath:
          path: /home/kubernetes/bin/gib
      - name: secret-ssh
        secret:
          secretName: kimi-k3-ssh-secret
          defaultMode: 0600
