# ==============================================================================
# 00d-serving-nccl-parity-job.yaml.template
# ==============================================================================
# Serving-Image NCCL Parity Gate (A7)
# Verifies NCCL all_reduce over the RoCEv2 fabric using the actual runtime
# serving image (${SERVING_IMAGE}) and identical gIB/NCCL environment as the
# serving workload.
#
# The world is ${SERVING_PODS} ranks: every node that will host a serving pod, not
# just one replica's worth. Serving replicas each form their own smaller world and
# never communicate across replicas, so this tests more of the fabric than
# production uses -- which is the point. Gating only the first two nodes would let
# a node with a dead RDMA NIC into replica B, where the fault surfaces seventeen
# minutes later as a dist-init hang with sixteen more B200s already on the meter.
#
# NOTE: In accordance with Kubernetes requirements for StatefulSet pod specs,
# restartPolicy is set to Always. After the parity check completes with exit 0,
# the supervising operator or deployment pipeline deletes this StatefulSet.
# ==============================================================================
apiVersion: v1
kind: Service
metadata:
  name: nccl-parity-svc
  namespace: llm-serving
spec:
  clusterIP: None
  publishNotReadyAddresses: true
  selector:
    app: nccl-parity-check
  ports:
  - port: 29500
    name: dist-init
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: nccl-parity-check
  namespace: llm-serving
spec:
  replicas: ${SERVING_PODS}
  serviceName: nccl-parity-svc
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: nccl-parity-check
  template:
    metadata:
      labels:
        app: nccl-parity-check
        env: ${ENV_LABEL}
        owner: ${OWNER_LABEL}
      annotations:
        networking.gke.io/default-interface: 'eth0'
        networking.gke.io/interfaces: |
          [
            {"interfaceName":"eth0","network":"default"},
            {"interfaceName":"eth2","network":"rdma-0"},
            {"interfaceName":"eth3","network":"rdma-1"},
            {"interfaceName":"eth4","network":"rdma-2"},
            {"interfaceName":"eth5","network":"rdma-3"},
            {"interfaceName":"eth6","network":"rdma-4"},
            {"interfaceName":"eth7","network":"rdma-5"},
            {"interfaceName":"eth8","network":"rdma-6"},
            {"interfaceName":"eth9","network":"rdma-7"}
          ]
    spec:
      subdomain: nccl-parity-svc
      restartPolicy: Always
      nodeSelector:
        cloud.google.com/gke-accelerator: nvidia-b200
        cloud.google.com/gke-spot: "true"
      tolerations:
      - key: "nvidia.com/gpu"
        operator: "Exists"
        effect: "NoSchedule"
      - key: "cloud.google.com/gke-spot"
        operator: "Exists"
        effect: "NoSchedule"
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
          - labelSelector:
              matchLabels:
                app: nccl-parity-check
            topologyKey: kubernetes.io/hostname
      containers:
      - name: nccl-parity-check
        image: ${SERVING_IMAGE}
        env:
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: POD_INDEX
          valueFrom:
            fieldRef:
              fieldPath: metadata.labels['apps.kubernetes.io/pod-index']
        - name: LD_LIBRARY_PATH
          value: "/usr/local/nvidia/lib64:/usr/local/gib/lib64:/usr/local/nvidia/lib:/usr/local/gib/lib"
        - name: NCCL_CONF_FILE
          value: "/usr/local/gib/scripts/nccl.conf"
        - name: NCCL_DEBUG
          value: "INFO"
        - name: NCCL_DEBUG_SUBSYS
          value: "INIT,NET,GRAPH"
        - name: NCCL_SOCKET_IFNAME
          value: "eth0"
        - name: GLOO_SOCKET_IFNAME
          value: "eth0"
        - name: SGLANG_TP_SIZE
          value: "${SGLANG_TP_SIZE}"
        # The parity world spans every serving node at once, so this is SERVING_PODS
        # rather than one replica's NODES_PER_REPLICA. Read by parity_test.py, which is
        # written from a quoted heredoc and therefore cannot be rendered into.
        - name: PARITY_WORLD_SIZE
          value: "${SERVING_PODS}"
        securityContext:
          capabilities:
            add:
            - IPC_LOCK
        command:
        - /bin/bash
        - -c
        - |
          set -euo pipefail
          if [ ! -r /usr/local/gib/scripts/set_nccl_env.sh ]; then
            echo "FATAL: gIB NCCL env script not readable at /usr/local/gib/scripts/set_nccl_env.sh." >&2
            echo "FATAL: Refusing to start — NCCL would silently fall back to TCP sockets (~50x bandwidth loss)." >&2
            exit 1
          fi
          source /usr/local/gib/scripts/set_nccl_env.sh
          echo "--- Resolved NCCL environment ---"
          env | grep -E '^NCCL_' | sort
          echo "---------------------------------"
          NODE_RANK=${POD_INDEX:-${HOSTNAME##*-}}
          export NODE_RANK
          PARITY_DOMAIN="nccl-parity-svc.llm-serving.svc.cluster.local"
          echo "Resolving ${PARITY_WORLD_SIZE} pod IPs for /etc/hosts..."
          PARITY_PEERS=""
          for PARITY_RANK in $(seq 0 $(( PARITY_WORLD_SIZE - 1 ))); do
            PARITY_PEERS="${PARITY_PEERS} nccl-parity-check-${PARITY_RANK}"
          done
          for PEER_NAME in ${PARITY_PEERS}; do
            while ! getent hosts "${PEER_NAME}.${PARITY_DOMAIN}" >/dev/null; do
              sleep 2
            done
          done
          for PEER_NAME in ${PARITY_PEERS}; do
            printf '%s\t%s\n' "$(getent hosts "${PEER_NAME}.${PARITY_DOMAIN}" | awk '{print $1}')" "${PEER_NAME}" >> /etc/hosts
          done
          echo "/etc/hosts populated successfully:"
          tail -n "${PARITY_WORLD_SIZE}" /etc/hosts

          cat << 'EOF' | sed 's/^          //' > /tmp/parity_test.py
          import os, sys
          import torch
          import torch.distributed as dist

          rank = int(os.environ.get("NODE_RANK", os.environ.get("HOSTNAME", "").split("-")[-1]))
          world_size = int(os.environ["PARITY_WORLD_SIZE"])
          print(f"[Rank {rank}] Initializing process group of {world_size} with NCCL backend...")
          dist.init_process_group(
              backend="nccl",
              init_method="tcp://nccl-parity-check-0.nccl-parity-svc.llm-serving.svc.cluster.local:29500",
              world_size=world_size,
              rank=rank
          )

          print(f"[Rank {rank}] Creating 256 MiB float64 tensor on CUDA...")
          tensor = torch.ones(33554432, dtype=torch.float64, device='cuda')

          print(f"[Rank {rank}] Executing all_reduce (SUM)...")
          dist.all_reduce(tensor, op=dist.ReduceOp.SUM)

          print(f"[Rank {rank}] Verifying tensor values after all_reduce...")
          # Every rank contributes ones, so a correct SUM is the world size. Hardcoding 2.0
          # here would have passed a four-node gate only if the fabric were broken.
          expected_val = float(world_size)
          if not torch.allclose(tensor, torch.full_like(tensor, expected_val)):
              print(f"[Rank {rank}] ERROR: Tensor all_reduce verification failed! Min={tensor.min().item()}, Max={tensor.max().item()}")
              sys.exit(1)

          print(f"[Rank {rank}] Tensor verification passed: all elements equal {expected_val}.")
          dist.barrier()
          print(f"[Rank {rank}] Barrier passed. Exiting 0.")
          sys.exit(0)
          EOF

          if [ "${NODE_RANK}" = "0" ]; then
            trap 'echo "NCCL_PARITY_RESULT fail"' ERR
          fi
          LOG_FILE=$(mktemp)
          echo "Running ${PARITY_WORLD_SIZE}-node NCCL parity check..."
          if ! python3 /tmp/parity_test.py 2>&1 | tee "${LOG_FILE}"; then
            if [ "${NODE_RANK}" = "0" ]; then
              echo "NCCL SERVING-IMAGE PARITY: FAIL" >&2
              echo "NCCL_PARITY_RESULT fail"
            fi
            exit 1
          fi

          if [ "${NODE_RANK}" = "0" ]; then
            echo "Verifying NCCL debug logs for NET/gIB on rank 0..."
            if grep -q "NET/gIB" "${LOG_FILE}"; then
              echo "NCCL SERVING-IMAGE PARITY: PASS"
              echo "NCCL_PARITY_RESULT pass"
            else
              echo "ERROR: NCCL debug output does not contain NET/gIB!" >&2
              echo "NCCL SERVING-IMAGE PARITY: FAIL" >&2
              echo "NCCL_PARITY_RESULT fail"
              exit 1
            fi
          else
            echo "Worker node rank ${NODE_RANK} parity check finished successfully."
          fi
          exit 0
        volumeMounts:
        - name: dshm
          mountPath: /dev/shm
        - name: nvidia-dir
          mountPath: /usr/local/nvidia
          readOnly: true
        - name: gib-dir
          mountPath: /usr/local/gib
          readOnly: true
        resources:
          limits:
            nvidia.com/gpu: 1
      volumes:
      - name: dshm
        emptyDir:
          medium: Memory
          sizeLimit: 512Gi
      - name: nvidia-dir
        hostPath:
          path: /home/kubernetes/bin/nvidia
      - name: gib-dir
        hostPath:
          path: /home/kubernetes/bin/gib
