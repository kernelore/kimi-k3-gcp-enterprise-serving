apiVersion: v1
kind: Service
metadata:
  name: kimi-k3-gateway-svc
  namespace: llm-serving
  labels:
    app: kimi-k3-gateway
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
  annotations:
    networking.gke.io/load-balancer-type: "Internal"
spec:
  type: LoadBalancer
  ports:
  - port: 4000
    targetPort: 4000
    name: http-gateway
  selector:
    app: kimi-k3-gateway
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kimi-k3-gateway
  namespace: llm-serving
  labels:
    app: kimi-k3-gateway
    ai.gke.io/model: "${SERVING_MODEL_LABEL}"
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
spec:
  replicas: 2
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: kimi-k3-gateway
  template:
    metadata:
      labels:
        app: kimi-k3-gateway
        ai.gke.io/model: "${SERVING_MODEL_LABEL}"
        env: ${ENV_LABEL}
        owner: ${OWNER_LABEL}
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "4000"
        prometheus.io/path: "/metrics"
        # Fingerprint of the rendered 04-enterprise-gateway-config.yaml. A ConfigMap update
        # alone does not restart pods, so without this a GATEWAY_MASTER_KEY rotation would
        # leave the old key live in the running gateway. Changing the config changes this
        # annotation, which changes the pod spec, which triggers a rolling update.
        kimi-k3.gke.io/gateway-config-checksum: "${GATEWAY_CONFIG_CHECKSUM}"
    spec:
      serviceAccountName: kimi-k3-gateway-sa
      terminationGracePeriodSeconds: 60
      nodeSelector:
        cloud.google.com/gke-nodepool: "np-system"
      containers:
      - name: litellm
        image: ghcr.io/berriai/litellm:main-v1.83.14-stable
        imagePullPolicy: IfNotPresent
        args:
        - "--config"
        - "/app/litellm_config.yaml"
        - "--port"
        - "4000"
        - "--num_workers"
        - "2"
        ports:
        - name: http-gateway
          containerPort: 4000
        envFrom:
        - secretRef:
            name: kimi-k3-gateway-secrets
        env:
        - name: PYTHONPATH
          value: "/app"
        - name: LITELLM_LOG
          value: "INFO"
        volumeMounts:
        - name: config-volume
          mountPath: /app/litellm_config.yaml
          subPath: litellm_config.yaml
          readOnly: true
        - name: config-volume
          mountPath: /app/custom_callbacks.py
          subPath: custom_callbacks.py
          readOnly: true
        livenessProbe:
          httpGet:
            path: /health/liveliness
            port: 4000
          initialDelaySeconds: 120
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 10
        readinessProbe:
          httpGet:
            path: /health/readiness
            port: 4000
          initialDelaySeconds: 45
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 10
        resources:
          requests:
            cpu: "2"
            memory: "4Gi"
          limits:
            cpu: "4"
            memory: "8Gi"

      - name: cloud-sql-proxy
        image: gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.14.1
        imagePullPolicy: IfNotPresent
        args:
        - "--private-ip"
        - "--port=5432"
        - "${DB_CONNECTION_NAME}"
        securityContext:
          runAsNonRoot: true
          runAsUser: 65532
        resources:
          requests:
            cpu: "500m"
            memory: "512Mi"
          limits:
            cpu: "1"
            memory: "1Gi"
      volumes:
      - name: config-volume
        configMap:
          name: kimi-k3-gateway-config
