apiVersion: batch/v1
kind: Job
metadata:
  name: kimi-k3-weight-staging-job
  namespace: llm-serving
  labels:
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
spec:
  template:
    metadata:
      labels:
        app: kimi-k3-weight-staging
    spec:
      serviceAccountName: kimi-k3-serving-sa
      restartPolicy: OnFailure
      nodeSelector:
        cloud.google.com/gke-accelerator: nvidia-b200
        cloud.google.com/gke-spot: "true"
      tolerations:
      - key: "nvidia.com/gpu"
        operator: "Exists"
        effect: "NoSchedule"
      - key: "cloud.google.com/gke-spot"
        operator: "Exists"
        effect: "NoSchedule"
      containers:
      - name: downloader-and-converter
        image: ${SERVING_IMAGE}
        resources:
          requests:
            cpu: "32"
            memory: "128Gi"
          limits:
            cpu: "64"
            memory: "256Gi"
        command: ["/bin/bash", "-c"]
        args:
        - |
          set -euo pipefail
          echo "Starting ${MODEL_REPO_ID} weight acquisition from Hugging Face Hub via Python snapshot_download()..."
          export HF_HUB_ENABLE_HF_TRANSFER=1
          mkdir -p /mnt/staging/Kimi-K3-2.8T-MXFP4
          python3 -c "
          import os, json, glob, sys
          from huggingface_hub import snapshot_download, HfApi
          from huggingface_hub.utils import RepositoryNotFoundError, GatedRepoError, HfHubHTTPError
          repo_id = os.environ['MODEL_REPO_ID']
          token = os.environ.get('HF_TOKEN')
          dest = '/mnt/staging/Kimi-K3-2.8T-MXFP4'
          print(f'=== HUGGING FACE PRE-FLIGHT CHECK FOR {repo_id} ===')
          api = HfApi(token=token)
          try:
              info = api.model_info(repo_id, files_metadata=True)
          except GatedRepoError:
              raise RuntimeError(f'FATAL [PRE-FLIGHT]: Repository {repo_id} is gated. The HF account holding HF_TOKEN must accept the model licence on the model page.')
          except RepositoryNotFoundError:
              raise RuntimeError(f'FATAL [PRE-FLIGHT]: Repository {repo_id} not found on Hugging Face Hub. Verify MODEL_REPO_ID.')
          except HfHubHTTPError as e:
              if getattr(e, 'response', None) is not None and getattr(e.response, 'status_code', 0) in (401, 403):
                  raise RuntimeError(f'FATAL [PRE-FLIGHT]: Authentication or licence access denied (HTTP {e.response.status_code}) for {repo_id}. Ensure HF_TOKEN is valid and licence is accepted.')
              raise RuntimeError(f'FATAL [PRE-FLIGHT]: HTTP error communicating with Hugging Face Hub for {repo_id}: {e}')
          except Exception as e:
              raise RuntimeError(f'FATAL [PRE-FLIGHT]: Failed to query repository info for {repo_id}: {e}')
          
          siblings = getattr(info, 'siblings', []) or []
          st_siblings = [s for s in siblings if getattr(s, 'rfilename', '').endswith('.safetensors')]
          remote_size = sum(getattr(s, 'size', 0) or 0 for s in st_siblings)
          remote_gib = remote_size / (1024**3)
          min_gib = float(os.getenv('MIN_WEIGHTS_GIB', '1000'))
          print(f'Resolved repo_id: {repo_id}')
          print(f'Remote .safetensors siblings count: {len(st_siblings)}')
          print(f'Remote total weight size: {remote_size} bytes ({remote_gib:.2f} GiB) | Required floor: MIN_WEIGHTS_GIB={min_gib:.2f} GiB')
          if remote_gib < min_gib:
              raise RuntimeError(f'FATAL [PRE-FLIGHT]: Remote repository {repo_id} total size ({remote_gib:.2f} GiB) is below required floor MIN_WEIGHTS_GIB={min_gib:.2f} GiB. Aborting before download.')
          print('===========================================================')
          print(f'Downloading {repo_id} to {dest}...')
          snapshot_download(repo_id=repo_id, local_dir=dest, token=token, max_workers=32)

          idx_path = os.path.join(dest, 'model.safetensors.index.json')
          if os.path.isfile(idx_path):
              with open(idx_path, 'r') as f:
                  data = json.load(f)
              weight_map = data.get('weight_map', {})
              files = set(weight_map.values())
              total_size = 0
              for fname in files:
                  fpath = os.path.join(dest, fname)
                  if not os.path.isfile(fpath):
                      raise RuntimeError(f'Missing required weight shard: {fname}')
                  total_size += os.path.getsize(fpath)
              print(f'Verified all {len(files)} safetensors weight shards referenced in index. Total size: {total_size} bytes ({total_size / (1024**3):.2f} GiB)')
          else:
              shards = glob.glob(os.path.join(dest, '*.safetensors'))
              if not shards:
                  raise RuntimeError('No *.safetensors files found in download destination.')
              total_size = 0
              for fpath in shards:
                  total_size += os.path.getsize(fpath)
              print(f'Verified {len(shards)} safetensors files present. Total size: {total_size} bytes ({total_size / (1024**3):.2f} GiB)')
          min_gib = float(os.getenv('MIN_WEIGHTS_GIB', '1000'))
          total_gib = total_size / (1024**3)
          if total_gib < min_gib:
              raise RuntimeError(f'FATAL: Total weight size {total_gib:.2f} GiB is below required floor MIN_WEIGHTS_GIB={min_gib:.2f} GiB.')
          cfg_path = os.path.join(dest, 'config.json')
          if os.path.isfile(cfg_path):
              with open(cfg_path, 'r') as f:
                  cfg = json.load(f)
              archs = cfg.get('architectures', ['Unknown'])
              arch = archs[0] if archs else 'Unknown'
              mtype = cfg.get('model_type', 'unknown')
              layers = cfg.get('num_hidden_layers', 'unknown')
              n_exp = cfg.get('n_routed_experts', cfg.get('num_local_experts', 'unknown'))
              print(f'=== MODEL PROVENANCE GATE ===\nArchitectures: {archs}\nModel Type: {mtype}\nHidden Layers: {layers}\nExperts: {n_exp}\n=============================')
              denylist = ['GlmMoeDsaForCausalLM', 'Glm4MoeForCausalLM', 'DeepseekV3ForCausalLM', 'DeepseekV32ForCausalLM']
              if arch in denylist:
                  raise RuntimeError(f'FATAL: Model architecture {arch} is in the known-wrong denylist. Refusing to proceed.')
              expected_arch = os.getenv('EXPECTED_MODEL_ARCHITECTURE', '')
              if expected_arch and arch != expected_arch:
                  raise RuntimeError(f'FATAL: Found architecture {arch} but EXPECTED_MODEL_ARCHITECTURE={expected_arch}.')
          else:
              raise RuntimeError(f'FATAL: config.json not found in {dest}; cannot verify model architecture.')
          "
          echo "${MODEL_REPO_ID} weights successfully downloaded to Hyperdisk ML."
        env:
        - name: HF_TOKEN
          valueFrom:
            secretKeyRef:
              name: hf-secret
              key: HF_TOKEN
        - name: MODEL_REPO_ID
          value: "${MODEL_REPO_ID}"
        - name: MIN_WEIGHTS_GIB
          value: "${MIN_WEIGHTS_GIB}"
        - name: EXPECTED_MODEL_ARCHITECTURE
          value: "${EXPECTED_MODEL_ARCHITECTURE}"
        volumeMounts:
        - name: staging
          mountPath: /mnt/staging
      volumes:
      - name: staging
        persistentVolumeClaim:
          claimName: pvc-kimi-k3-weights-staging
          readOnly: false
