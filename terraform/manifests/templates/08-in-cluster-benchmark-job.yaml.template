apiVersion: batch/v1
kind: Job
metadata:
  name: kimi-k3-incluster-benchmark
  namespace: llm-serving
  labels:
    app: kimi-k3-benchmark
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
spec:
  backoffLimit: 2
  ttlSecondsAfterFinished: 3600
  # The binding case is the saturation sweep, not the soak test this template was first
  # written for. Its DAY-1 grid is 4 ISL/OSL pairs x 4 concurrency levels, of which 13 cells
  # run (the 3 above MAX_INFLIGHT_PROMPT_TOKENS are reported as skipped); the c=1 cells alone
  # execute 8 sequential requests of up to 2048 output tokens each on top of a 128k-token
  # prefill. At the measured ~34 ms TPOT that single suite comfortably exceeds one hour, so
  # the old 3600s deadline would have killed the Job mid-sweep and destroyed the run --
  # silently, because the partial results never reach the output file.
  activeDeadlineSeconds: 10800
  template:
    metadata:
      labels:
        app: kimi-k3-benchmark
        env: ${ENV_LABEL}
    spec:
      serviceAccountName: kimi-k3-serving-sa
      restartPolicy: Never
      nodeSelector:
        cloud.google.com/gke-nodepool: "np-system"
      containers:
      - name: bench-runner
        image: python:3.11-slim
        env:
        - name: GATEWAY_MASTER_KEY
          valueFrom:
            secretKeyRef:
              name: kimi-k3-gateway-secrets
              key: GATEWAY_MASTER_KEY
        - name: SERVING_MODEL_NAME
          value: "${SERVING_MODEL_NAME}"
        # Python block-buffers stdout when it is a pipe rather than a TTY, which it always
        # is here. Only the soak harness flushes by hand, so every other suite emitted
        # nothing to `kubectl logs` until it exited -- a 40-minute saturation sweep that
        # looks indistinguishable from a hung one for its entire run. Unbuffer at the
        # container level so progress from any harness streams as it is produced.
        - name: PYTHONUNBUFFERED
          value: "1"
        # The saturation sweep drives up to 128 concurrent SSE streams from a Python
        # ThreadPoolExecutor in this pod, and every first-token timestamp -- the TTFT the
        # suite reports -- is taken client-side. Starving the load generator makes the
        # server look slower than it is, so give it most of an np-system node (7910m
        # allocatable) rather than the 2/4 CPU that was adequate for the 18-stream soak.
        resources:
          requests:
            cpu: "4"
            memory: "4Gi"
          limits:
            cpu: "7"
            memory: "8Gi"
        command: ["/bin/bash", "-c"]
        args:
        - |
          set -euo pipefail
          echo "======================================================================"
          echo "Starting Kimi K3 In-Cluster Benchmark Suite (Soak Endurance Test)..."
          echo "======================================================================"
          mkdir -p /tmp/results
          python3 /workspace/benchmarks/soak_benchmark_kimi_k3.py \
            --endpoint="${BENCHMARK_ENDPOINT}" \
            --api-key="${GATEWAY_MASTER_KEY}" \
            --model="${SERVING_MODEL_NAME}" \
            --engine="${BENCHMARK_ENGINE}" \
            --metadata='${BENCHMARK_METADATA_JSON}' \
            --output="/tmp/results/incluster_soak_results.json"
          echo "=== JSON_RESULT_START ==="
          cat /tmp/results/incluster_soak_results.json || true
          echo ""
          echo "=== JSON_RESULT_END ==="
          echo "In-cluster benchmark execution finished successfully."
        volumeMounts:
        - name: bench-scripts
          mountPath: /workspace/benchmarks
      volumes:
      - name: bench-scripts
        configMap:
          name: kimi-k3-benchmark-scripts
