apiVersion: v1
kind: PersistentVolume
metadata:
  name: pv-kimi-k3-weights-rox
spec:
  storageClassName: ""
  capacity:
    storage: 2000Gi
  accessModes:
    - ReadOnlyMany
  mountOptions:
    - nouuid
    - ro
    - norecovery
  csi:
    driver: pd.csi.storage.gke.io
    volumeHandle: projects/${PROJECT_ID}/zones/${ZONE}/disks/kimi-k3-weights-rox
    fsType: xfs
    readOnly: true
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pvc-kimi-k3-weights-rox
  namespace: llm-serving
spec:
  storageClassName: ""
  volumeName: pv-kimi-k3-weights-rox
  accessModes:
    - ReadOnlyMany
  resources:
    requests:
      storage: 2000Gi
---
apiVersion: v1
kind: Service
metadata:
  name: kimi-k3-workers-headless
  namespace: llm-serving
spec:
  clusterIP: None
  publishNotReadyAddresses: true
  selector:
    app: kimi-k3-serving
  ports:
  - port: 5000
    name: dist-init
  - port: 2222
    name: mpi-ring
---
apiVersion: v1
kind: Service
metadata:
  name: kimi-k3-serving-svc
  namespace: llm-serving
  annotations:
    networking.gke.io/load-balancer-type: "Internal"
spec:
  type: LoadBalancer
  ports:
  - port: 8000
    targetPort: 8000
    name: http-api
  selector:
    app: kimi-k3-serving
    apps.kubernetes.io/pod-index: "0"
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: kimi-k3-serving
  namespace: llm-serving
spec:
  replicas: 2
  serviceName: kimi-k3-workers-headless
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: kimi-k3-serving
  template:
    metadata:
      labels:
        app: kimi-k3-serving
        engine: sglang
      annotations:
        networking.gke.io/default-interface: 'eth0'
        networking.gke.io/interfaces: |
          [
            {"interfaceName":"eth0","network":"default"},
            {"interfaceName":"eth2","network":"rdma-0"},
            {"interfaceName":"eth3","network":"rdma-1"},
            {"interfaceName":"eth4","network":"rdma-2"},
            {"interfaceName":"eth5","network":"rdma-3"},
            {"interfaceName":"eth6","network":"rdma-4"},
            {"interfaceName":"eth7","network":"rdma-5"},
            {"interfaceName":"eth8","network":"rdma-6"},
            {"interfaceName":"eth9","network":"rdma-7"}
          ]
    spec:
      terminationGracePeriodSeconds: 120
      nodeSelector:
        cloud.google.com/gke-accelerator: nvidia-b200
        cloud.google.com/gke-spot: "true"
      tolerations:
      - key: "nvidia.com/gpu"
        operator: "Exists"
        effect: "NoSchedule"
      - key: "cloud.google.com/gke-spot"
        operator: "Exists"
        effect: "NoSchedule"
      containers:
      - name: sglang-mpi-node
        image: ${SERVING_IMAGE}
        env:
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: POD_INDEX
          valueFrom:
            fieldRef:
              fieldPath: metadata.labels['apps.kubernetes.io/pod-index']
        - name: LD_LIBRARY_PATH
          value: "/usr/local/nvidia/lib64:/usr/local/gib/lib64:/usr/local/nvidia/lib:/usr/local/gib/lib"
        - name: NCCL_CONF_FILE
          value: "/usr/local/gib/scripts/nccl.conf"
        - name: NCCL_DEBUG
          value: "INFO"
        - name: NCCL_DEBUG_SUBSYS
          value: "INIT,NET,GRAPH"
        - name: NCCL_SOCKET_IFNAME
          value: "eth0"
        - name: SGLANG_TP_SIZE
          value: "${SGLANG_TP_SIZE}"
        - name: SGLANG_PP_SIZE
          value: "${SGLANG_PP_SIZE}"
        - name: SGLANG_PP_LAYER_PARTITION
          value: "${SGLANG_PP_LAYER_PARTITION}"
        - name: SGLANG_EP_SIZE
          value: "${SGLANG_EP_SIZE}"
        - name: SGLANG_PORT
          value: "${SGLANG_PORT}"
        - name: SGLANG_MEM_FRACTION_STATIC
          value: "${SGLANG_MEM_FRACTION_STATIC}"
        - name: SGLANG_SCHEDULE_POLICY
          value: "${SGLANG_SCHEDULE_POLICY}"
        - name: SGLANG_QUANTIZATION
          value: "${SGLANG_QUANTIZATION}"
        - name: SGLANG_ENABLE_TORCH_COMPILE
          value: "${SGLANG_ENABLE_TORCH_COMPILE}"
        - name: SGLANG_ATTENTION_BACKEND
          value: "${SGLANG_ATTENTION_BACKEND}"
        - name: SGLANG_CONTEXT_LENGTH
          value: "${SGLANG_CONTEXT_LENGTH}"
        - name: SGLANG_REASONING_PARSER
          value: "${SGLANG_REASONING_PARSER}"
        - name: SGLANG_TOOL_CALL_PARSER
          value: "${SGLANG_TOOL_CALL_PARSER}"
        - name: MIN_WEIGHTS_GIB
          value: "${MIN_WEIGHTS_GIB}"
        - name: EXPECTED_MODEL_ARCHITECTURE
          value: "${EXPECTED_MODEL_ARCHITECTURE}"
        securityContext:
          capabilities:
            add:
            - IPC_LOCK
        startupProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "if [ \"${HOSTNAME##*-}\" = \"0\" ]; then curl -sf http://localhost:8000/health; else pgrep -f sglang.launch_server >/dev/null; fi"
          periodSeconds: 30
          failureThreshold: 120
          timeoutSeconds: 10
        readinessProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "if [ \"${HOSTNAME##*-}\" = \"0\" ]; then curl -sf http://localhost:8000/health; else pgrep -f sglang.launch_server >/dev/null; fi"
          periodSeconds: 15
          failureThreshold: 4
          timeoutSeconds: 5
        livenessProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "pgrep -f sglang.launch_server >/dev/null"
          periodSeconds: 60
          failureThreshold: 10
          timeoutSeconds: 5
        lifecycle:
          preStop:
            exec:
              command: ["/bin/sh", "-c", "sleep 20"]
        command:
        - /bin/bash
        - -c
        - |
          set -euo pipefail
          if [ ! -r /usr/local/gib/scripts/set_nccl_env.sh ]; then
            echo "FATAL: gIB NCCL env script not readable at /usr/local/gib/scripts/set_nccl_env.sh." >&2
            echo "FATAL: Refusing to start — NCCL would silently fall back to TCP sockets (~50x bandwidth loss)." >&2
            exit 1
          fi
          source /usr/local/gib/scripts/set_nccl_env.sh
          echo "--- Resolved NCCL environment ---"
          env | grep -E '^NCCL_' | sort
          echo "---------------------------------"
          python3 -c "
          import os, glob, json, sys
          dest = '/mnt/rox/Kimi-K3'
          shards = glob.glob(os.path.join(dest, '*.safetensors'))
          total_size = sum(os.path.getsize(f) for f in shards)
          min_gib = float(os.getenv('MIN_WEIGHTS_GIB', '1000'))
          total_gib = total_size / (1024**3)
          if total_gib < min_gib:
              print(f'FATAL: Total weight size {total_gib:.2f} GiB in {dest} is below required floor MIN_WEIGHTS_GIB={min_gib:.2f} GiB.', file=sys.stderr)
              sys.exit(1)
          cfg_path = os.path.join(dest, 'config.json')
          if os.path.isfile(cfg_path):
              with open(cfg_path, 'r') as f:
                  cfg = json.load(f)
              archs = cfg.get('architectures', ['Unknown'])
              arch = archs[0] if archs else 'Unknown'
              mtype = cfg.get('model_type', 'unknown')
              layers = cfg.get('num_hidden_layers', 'unknown')
              n_exp = cfg.get('n_routed_experts', cfg.get('num_local_experts', 'unknown'))
              print(f'=== MODEL PROVENANCE GATE ===\nArchitectures: {archs}\nModel Type: {mtype}\nHidden Layers: {layers}\nExperts: {n_exp}\n=============================')
              denylist = ['GlmMoeDsaForCausalLM', 'Glm4MoeForCausalLM', 'DeepseekV3ForCausalLM', 'DeepseekV32ForCausalLM']
              if arch in denylist:
                  print(f'FATAL: Model architecture {arch} is in the known-wrong denylist. Refusing to start.', file=sys.stderr)
                  sys.exit(1)
              expected_arch = os.getenv('EXPECTED_MODEL_ARCHITECTURE', '')
              if expected_arch and arch != expected_arch:
                  print(f'FATAL: Found architecture {arch} but EXPECTED_MODEL_ARCHITECTURE={expected_arch}.', file=sys.stderr)
                  sys.exit(1)
          else:
              print(f'FATAL: config.json not found in {dest}; cannot verify model architecture.', file=sys.stderr)
              sys.exit(1)
          "
          echo "Populating peer short hostnames in /etc/hosts..."
          while ! getent hosts kimi-k3-serving-0.kimi-k3-workers-headless.llm-serving.svc.cluster.local >/dev/null || ! getent hosts kimi-k3-serving-1.kimi-k3-workers-headless.llm-serving.svc.cluster.local >/dev/null; do
            echo "Waiting for peer DNS A-records..."
            sleep 2
          done
          IP0=$(getent hosts kimi-k3-serving-0.kimi-k3-workers-headless.llm-serving.svc.cluster.local | awk '{print $1}')
          IP1=$(getent hosts kimi-k3-serving-1.kimi-k3-workers-headless.llm-serving.svc.cluster.local | awk '{print $1}')
          echo -e "${IP0}\tkimi-k3-serving-0\n${IP1}\tkimi-k3-serving-1" >> /etc/hosts
          cat /etc/hosts | tail -n 2
          NODE_RANK=${POD_INDEX:-${HOSTNAME##*-}}
          LEADER_HOST="${LEADER_ADDR}:5000"
          echo "Starting SGLang worker node rank ${NODE_RANK} connecting to leader ${LEADER_HOST}..."
          EXTRA_ARGS=""
          if [ -n "${SGLANG_QUANTIZATION}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --quantization ${SGLANG_QUANTIZATION}"
          fi
          if [ "${SGLANG_ENABLE_TORCH_COMPILE}" = "true" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --enable-torch-compile"
          fi
          if [ -n "${SGLANG_ATTENTION_BACKEND}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --attention-backend ${SGLANG_ATTENTION_BACKEND}"
          fi
          if [ -n "${SGLANG_REASONING_PARSER}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --reasoning-parser ${SGLANG_REASONING_PARSER}"
          fi
          if [ -n "${SGLANG_TOOL_CALL_PARSER}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --tool-call-parser ${SGLANG_TOOL_CALL_PARSER}"
          fi
          EXTRA_ARGS="${EXTRA_ARGS} --moe-runner-backend flashinfer_mxfp4 --decode-attention-backend flashmla --kv-cache-dtype fp8_e4m3"
          # DAY-0: --disable-cuda-graph (or --cuda-graph-backend-decode=disabled) if CUDA graph capture OOMs occur on Blackwell during warmup; drop --mem-fraction-static to 0.80 if OOM at ~94% of weight loading
          if [ -z "${SGLANG_PP_LAYER_PARTITION:-}" ]; then unset SGLANG_PP_LAYER_PARTITION; fi
          # Multi-node loading of the 1.56 TB checkpoint can exceed the default distributed-init timeout
          exec python3 -m sglang.launch_server \
            --model-path /mnt/rox/Kimi-K3 \
            --dist-init-addr "${LEADER_HOST}" \
            --dist-timeout 3600 \
            --nnodes 2 \
            --node-rank "${NODE_RANK}" \
            --port "${SGLANG_PORT}" \
            --host 0.0.0.0 \
            --trust-remote-code \
            --enable-metrics \
            --context-length "${SGLANG_CONTEXT_LENGTH}" \
            --tp-size "${SGLANG_TP_SIZE}" \
            --pp-size "${SGLANG_PP_SIZE}" \
            --ep-size "${SGLANG_EP_SIZE}" \
            --mem-fraction-static "${SGLANG_MEM_FRACTION_STATIC}" \
            --schedule-policy "${SGLANG_SCHEDULE_POLICY}" \
            ${EXTRA_ARGS}
        ports:
        - containerPort: 8000
          name: http
        - containerPort: 5000
          name: dist-init
        volumeMounts:
        - name: model-rox
          mountPath: /mnt/rox
          readOnly: true
        - name: dshm
          mountPath: /dev/shm
        - name: nvidia-dir
          mountPath: /usr/local/nvidia
          readOnly: true
        - name: gib-dir
          mountPath: /usr/local/gib
          readOnly: true
        resources:
          requests:
            cpu: "32"
            memory: "768Gi"
          limits:
            memory: "1400Gi"
            nvidia.com/gpu: 8
      volumes:
      - name: model-rox
        persistentVolumeClaim:
          claimName: pvc-kimi-k3-weights-rox
      - name: dshm
        emptyDir:
          medium: Memory
          sizeLimit: 512Gi
      - name: nvidia-dir
        hostPath:
          path: /home/kubernetes/bin/nvidia
      - name: gib-dir
        hostPath:
          path: /home/kubernetes/bin/gib
