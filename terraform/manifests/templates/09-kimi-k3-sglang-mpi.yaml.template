apiVersion: v1
kind: PersistentVolume
metadata:
  name: pv-kimi-k3-weights-rox
spec:
  storageClassName: ""
  capacity:
    storage: 2000Gi
  accessModes:
    - ReadOnlyMany
  mountOptions:
    - nouuid
    - ro
    - norecovery
  csi:
    driver: pd.csi.storage.gke.io
    volumeHandle: projects/${PROJECT_ID}/zones/${ZONE}/disks/kimi-k3-weights-rox
    fsType: xfs
    readOnly: true
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pvc-kimi-k3-weights-rox
  namespace: llm-serving
spec:
  storageClassName: ""
  volumeName: pv-kimi-k3-weights-rox
  accessModes:
    - ReadOnlyMany
  resources:
    requests:
      storage: 2000Gi
---
apiVersion: v1
kind: Service
metadata:
  name: kimi-k3-workers-headless
  namespace: llm-serving
spec:
  clusterIP: None
  publishNotReadyAddresses: true
  selector:
    app: kimi-k3-serving
  ports:
  - port: 5000
    name: dist-init
  - port: 2222
    name: mpi-ring
---
apiVersion: v1
kind: Service
metadata:
  name: kimi-k3-serving-svc
  namespace: llm-serving
  annotations:
    networking.gke.io/load-balancer-type: "Internal"
spec:
  type: LoadBalancer
  ports:
  - port: 8000
    targetPort: 8000
    name: http-api
  selector:
    app: kimi-k3-serving
    apps.kubernetes.io/pod-index: "0"
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: kimi-k3-serving
  namespace: llm-serving
spec:
  replicas: 2
  serviceName: kimi-k3-workers-headless
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: kimi-k3-serving
  template:
    metadata:
      labels:
        app: kimi-k3-serving
        engine: sglang
      annotations:
        networking.gke.io/default-interface: 'eth0'
        networking.gke.io/interfaces: |
          [
            {"interfaceName":"eth0","network":"default"},
            {"interfaceName":"eth2","network":"rdma-0"},
            {"interfaceName":"eth3","network":"rdma-1"},
            {"interfaceName":"eth4","network":"rdma-2"},
            {"interfaceName":"eth5","network":"rdma-3"},
            {"interfaceName":"eth6","network":"rdma-4"},
            {"interfaceName":"eth7","network":"rdma-5"},
            {"interfaceName":"eth8","network":"rdma-6"},
            {"interfaceName":"eth9","network":"rdma-7"}
          ]
    spec:
      terminationGracePeriodSeconds: 120
      nodeSelector:
        cloud.google.com/gke-accelerator: nvidia-b200
        cloud.google.com/gke-spot: "true"
      tolerations:
      - key: "nvidia.com/gpu"
        operator: "Exists"
        effect: "NoSchedule"
      - key: "cloud.google.com/gke-spot"
        operator: "Exists"
        effect: "NoSchedule"
      serviceAccountName: ${SERVING_POD_SERVICE_ACCOUNT}
      initContainers:
      # DSPARK draft checkpoint fetch. The draft (~4 GiB) lands in a pod-local
      # emptyDir rather than on the ROX Hyperdisk that carries the base weights.
      # That disk is READ_ONLY_MANY once hydrated and the only supported way to add
      # a file to it is to delete it and re-stage all 1.45 TiB, which would make
      # speculative decoding impossible to switch on for an already-running cluster
      # and would risk the hydrated checkpoint for the sake of a 4 GiB file. Copying
      # per pod costs about ten seconds at the ~450 MiB/s this bucket sustains, and
      # each pod needs its own local copy anyway. The step is a no-op when
      # SGLANG_SPECULATIVE_ALGORITHM is empty, so the non-speculative deployment
      # pays nothing but a container start.
      - name: dspark-draft-fetch
        image: google/cloud-sdk:500.0.0-slim
        command: ["/bin/bash", "-c"]
        args:
        - |
          set -euo pipefail
          if [ -z "${SGLANG_SPECULATIVE_ALGORITHM}" ]; then
            echo "Speculative decoding is disabled; no draft checkpoint to fetch."
            exit 0
          fi
          DEST="/mnt/draft/${DSPARK_DRAFT_DIR_NAME}"
          echo "Fetching DSPARK draft ${GCS_WEIGHTS_BUCKET}/${DSPARK_DRAFT_DIR_NAME} -> ${DEST}"
          if ! gcloud storage ls "${GCS_WEIGHTS_BUCKET}/${DSPARK_DRAFT_DIR_NAME}/**" >/dev/null 2>&1; then
            echo "FATAL: speculative decoding is enabled but ${GCS_WEIGHTS_BUCKET}/${DSPARK_DRAFT_DIR_NAME} is empty or absent." >&2
            echo "       Stage the RadixArk/Kimi-K3-DSpark checkpoint into that prefix first." >&2
            exit 1
          fi
          mkdir -p "${DEST}"
          gcloud storage rsync -r "${GCS_WEIGHTS_BUCKET}/${DSPARK_DRAFT_DIR_NAME}" "${DEST}/"
          # The draft repository ships no generation_config.json and SGLang refuses to
          # load a draft model without one. The day-0 recipe copies the base model's
          # file across; doing it here means no operator has to remember.
          cp /mnt/rox/Kimi-K3/generation_config.json "${DEST}/generation_config.json"
          python3 -c "
          import glob, os
          d = '${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH}'
          shards = glob.glob(os.path.join(d, '*.safetensors'))
          if not shards:
              raise RuntimeError(f'FATAL: no safetensors shards found in draft checkpoint {d}.')
          if not os.path.isfile(os.path.join(d, 'config.json')):
              raise RuntimeError(f'FATAL: draft checkpoint {d} has no config.json.')
          size_gib = sum(os.path.getsize(f) for f in shards) / (1024**3)
          print(f'=== DSPARK DRAFT GATE ===\nShards: {len(shards)}\nSize: {size_gib:.2f} GiB\n=========================')
          "
        env:
        - name: SGLANG_SPECULATIVE_ALGORITHM
          value: "${SGLANG_SPECULATIVE_ALGORITHM}"
        - name: DSPARK_DRAFT_DIR_NAME
          value: "${DSPARK_DRAFT_DIR_NAME}"
        resources:
          requests:
            cpu: "4"
            memory: "8Gi"
          limits:
            memory: "16Gi"
        volumeMounts:
        - name: dspark-draft
          mountPath: /mnt/draft
        - name: model-rox
          mountPath: /mnt/rox
          readOnly: true
      containers:
      - name: sglang-mpi-node
        image: ${SERVING_IMAGE}
        env:
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: POD_INDEX
          valueFrom:
            fieldRef:
              fieldPath: metadata.labels['apps.kubernetes.io/pod-index']
        - name: LD_LIBRARY_PATH
          value: "/usr/local/nvidia/lib64:/usr/local/gib/lib64:/usr/local/nvidia/lib:/usr/local/gib/lib"
        - name: NCCL_CONF_FILE
          value: "/usr/local/gib/scripts/nccl.conf"
        - name: NCCL_DEBUG
          value: "INFO"
        - name: NCCL_DEBUG_SUBSYS
          value: "INIT,NET,GRAPH"
        - name: NCCL_SOCKET_IFNAME
          value: "eth0"
        - name: GLOO_SOCKET_IFNAME
          value: "eth0"
        - name: PYTORCH_CUDA_ALLOC_CONF
          value: "expandable_segments:True"
        - name: SGLANG_TP_SIZE
          value: "${SGLANG_TP_SIZE}"
        - name: SGLANG_PP_SIZE
          value: "${SGLANG_PP_SIZE}"
        - name: SGLANG_PP_LAYER_PARTITION
          value: "${SGLANG_PP_LAYER_PARTITION}"
        - name: SGLANG_EP_SIZE
          value: "${SGLANG_EP_SIZE}"
        # NOTE: this env var MUST NOT be named SGLANG_PORT. SGLANG_PORT is a
        # reserved SGLang setting (srt/environ.py); when set, get_open_port()
        # returns it instead of an ephemeral port, so the rank-0 scheduler binds
        # the API port for its cross-node MessageQueue XPUB socket during model
        # init and uvicorn then fails with EADDRINUSE on 0.0.0.0:8000, exiting 3
        # in _wait_and_warmup. The generous startupProbe masks this as a ~8 min
        # crash loop. The --port flag below is substituted at render time, so
        # this variable is informational only.
        - name: SGLANG_API_PORT
          value: "${SGLANG_PORT}"
        - name: SGLANG_MEM_FRACTION_STATIC
          value: "${SGLANG_MEM_FRACTION_STATIC}"
        - name: SGLANG_SCHEDULE_POLICY
          value: "${SGLANG_SCHEDULE_POLICY}"
        - name: SGLANG_CHUNKED_PREFILL_SIZE
          value: "${SGLANG_CHUNKED_PREFILL_SIZE}"
        - name: SGLANG_MAX_RUNNING_REQUESTS
          value: "${SGLANG_MAX_RUNNING_REQUESTS}"
        - name: SGLANG_DISABLE_CUSTOM_ALL_REDUCE
          value: "${SGLANG_DISABLE_CUSTOM_ALL_REDUCE}"
        - name: SGLANG_SPECULATIVE_ALGORITHM
          value: "${SGLANG_SPECULATIVE_ALGORITHM}"
        - name: SGLANG_SPECULATIVE_DRAFT_MODEL_PATH
          value: "${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH}"
        - name: SGLANG_SPECULATIVE_DSPARK_BLOCK_SIZE
          value: "${SGLANG_SPECULATIVE_DSPARK_BLOCK_SIZE}"
        - name: SGLANG_ENABLE_LINEAR_REPLAYSSM_SPEC
          value: "${SGLANG_ENABLE_LINEAR_REPLAYSSM_SPEC}"
        - name: SGLANG_QUANTIZATION
          value: "${SGLANG_QUANTIZATION}"
        - name: SGLANG_ENABLE_TORCH_COMPILE
          value: "${SGLANG_ENABLE_TORCH_COMPILE}"
        - name: SGLANG_PREFILL_ATTENTION_BACKEND
          value: "${SGLANG_PREFILL_ATTENTION_BACKEND}"
        - name: SGLANG_DECODE_ATTENTION_BACKEND
          value: "${SGLANG_DECODE_ATTENTION_BACKEND}"
        - name: SGLANG_LINEAR_ATTN_PREFILL_BACKEND
          value: "${SGLANG_LINEAR_ATTN_PREFILL_BACKEND}"
        - name: SGLANG_MOE_RUNNER_BACKEND
          value: "${SGLANG_MOE_RUNNER_BACKEND}"
        - name: SGLANG_KV_CACHE_DTYPE
          value: "${SGLANG_KV_CACHE_DTYPE}"
        - name: SGLANG_ENABLE_HIERARCHICAL_CACHE
          value: "${SGLANG_ENABLE_HIERARCHICAL_CACHE}"
        - name: SGLANG_HICACHE_RATIO
          value: "${SGLANG_HICACHE_RATIO}"
        - name: SGLANG_HICACHE_SIZE
          value: "${SGLANG_HICACHE_SIZE}"
        - name: SGLANG_HICACHE_WRITE_POLICY
          value: "${SGLANG_HICACHE_WRITE_POLICY}"
        - name: SGLANG_HICACHE_IO_BACKEND
          value: "${SGLANG_HICACHE_IO_BACKEND}"
        - name: SGLANG_HICACHE_STORAGE_BACKEND
          value: "${SGLANG_HICACHE_STORAGE_BACKEND}"
        # Consumed by SGLang itself, not by the launch wrapper. HiCacheFile reads this
        # env var directly (srt/mem_cache/hicache_storage.py) and falls back to
        # /tmp/hicache -- the container filesystem, which is the node boot disk. Pointing
        # it at the NVMe RAID mount is the whole reason the array is mounted below.
        - name: SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR
          value: "${SGLANG_LOCAL_SCRATCH_MOUNT}/hicache"
        # Bounds the on-disk cache so a long soak cannot fill the array. Eviction starts
        # at EVICTION_RATIO of MAX_SIZE; MIN_FREE_SPACE is a hard floor in bytes.
        - name: SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE
          value: "${SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE}"
        - name: SGLANG_CONTEXT_LENGTH
          value: "${SGLANG_CONTEXT_LENGTH}"
        - name: SGLANG_REASONING_PARSER
          value: "${SGLANG_REASONING_PARSER}"
        - name: SGLANG_TOOL_CALL_PARSER
          value: "${SGLANG_TOOL_CALL_PARSER}"
        - name: MIN_WEIGHTS_GIB
          value: "${MIN_WEIGHTS_GIB}"
        - name: EXPECTED_MODEL_ARCHITECTURE
          value: "${EXPECTED_MODEL_ARCHITECTURE}"
        securityContext:
          capabilities:
            add:
            - IPC_LOCK
        startupProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "if [ \"${HOSTNAME##*-}\" = \"0\" ]; then curl -sf http://localhost:8000/health; else pgrep -f sglang.launch_server >/dev/null; fi"
          periodSeconds: 30
          failureThreshold: 120
          timeoutSeconds: 10
        readinessProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "if [ \"${HOSTNAME##*-}\" = \"0\" ]; then curl -sf http://localhost:8000/health; else pgrep -f sglang.launch_server >/dev/null; fi"
          periodSeconds: 15
          failureThreshold: 4
          timeoutSeconds: 5
        livenessProbe:
          exec:
            command:
            - /bin/bash
            - -c
            - "pgrep -f sglang.launch_server >/dev/null"
          periodSeconds: 60
          failureThreshold: 10
          timeoutSeconds: 5
        lifecycle:
          preStop:
            exec:
              command: ["/bin/sh", "-c", "sleep 20"]
        command:
        - /bin/bash
        - -c
        - |
          set -euo pipefail
          if [ ! -r /usr/local/gib/scripts/set_nccl_env.sh ]; then
            echo "FATAL: gIB NCCL env script not readable at /usr/local/gib/scripts/set_nccl_env.sh." >&2
            echo "FATAL: Refusing to start — NCCL would silently fall back to TCP sockets (~50x bandwidth loss)." >&2
            exit 1
          fi
          source /usr/local/gib/scripts/set_nccl_env.sh
          echo "--- Resolved NCCL environment ---"
          env | grep -E '^NCCL_' | sort
          echo "---------------------------------"
          python3 -c "
          import os, glob, json, sys
          dest = '/mnt/rox/Kimi-K3'
          shards = glob.glob(os.path.join(dest, '*.safetensors'))
          total_size = sum(os.path.getsize(f) for f in shards)
          min_gib = float(os.getenv('MIN_WEIGHTS_GIB', '1000'))
          total_gib = total_size / (1024**3)
          if total_gib < min_gib:
              print(f'FATAL: Total weight size {total_gib:.2f} GiB in {dest} is below required floor MIN_WEIGHTS_GIB={min_gib:.2f} GiB.', file=sys.stderr)
              sys.exit(1)
          cfg_path = os.path.join(dest, 'config.json')
          if os.path.isfile(cfg_path):
              with open(cfg_path, 'r') as f:
                  cfg = json.load(f)
              archs = cfg.get('architectures', ['Unknown'])
              arch = archs[0] if archs else 'Unknown'
              mtype = cfg.get('model_type', 'unknown')
              layers = cfg.get('num_hidden_layers', 'unknown')
              n_exp = cfg.get('n_routed_experts', cfg.get('num_local_experts', 'unknown'))
              print(f'=== MODEL PROVENANCE GATE ===\nArchitectures: {archs}\nModel Type: {mtype}\nHidden Layers: {layers}\nExperts: {n_exp}\n=============================')
              denylist = ['GlmMoeDsaForCausalLM', 'Glm4MoeForCausalLM', 'DeepseekV3ForCausalLM', 'DeepseekV32ForCausalLM']
              if arch in denylist:
                  print(f'FATAL: Model architecture {arch} is in the known-wrong denylist. Refusing to start.', file=sys.stderr)
                  sys.exit(1)
              expected_arch = os.getenv('EXPECTED_MODEL_ARCHITECTURE', '')
              if expected_arch and arch != expected_arch:
                  print(f'FATAL: Found architecture {arch} but EXPECTED_MODEL_ARCHITECTURE={expected_arch}.', file=sys.stderr)
                  sys.exit(1)
          else:
              print(f'FATAL: config.json not found in {dest}; cannot verify model architecture.', file=sys.stderr)
              sys.exit(1)
          "
          echo "Populating peer short hostnames in /etc/hosts..."
          while ! getent hosts kimi-k3-serving-0.kimi-k3-workers-headless.llm-serving.svc.cluster.local >/dev/null || ! getent hosts kimi-k3-serving-1.kimi-k3-workers-headless.llm-serving.svc.cluster.local >/dev/null; do
            echo "Waiting for peer DNS A-records..."
            sleep 2
          done
          IP0=$(getent hosts kimi-k3-serving-0.kimi-k3-workers-headless.llm-serving.svc.cluster.local | awk '{print $1}')
          IP1=$(getent hosts kimi-k3-serving-1.kimi-k3-workers-headless.llm-serving.svc.cluster.local | awk '{print $1}')
          echo -e "${IP0}\tkimi-k3-serving-0\n${IP1}\tkimi-k3-serving-1" >> /etc/hosts
          cat /etc/hosts | tail -n 2
          NODE_RANK=${POD_INDEX:-${HOSTNAME##*-}}
          LEADER_HOST="${LEADER_ADDR}:5000"
          echo "Starting SGLang worker node rank ${NODE_RANK} connecting to leader ${LEADER_HOST}..."
          # --trust-remote-code makes transformers materialise the Kimi K3 modelling code
          # under HF_MODULES_CACHE. Give each rank its own directory: the default lives on
          # the container's HOME and is not guaranteed writable or rank-private.
          export HF_MODULES_CACHE="/tmp/hf_modules_${POD_INDEX:-0}"
          EXTRA_ARGS=""
          if [ -n "${SGLANG_QUANTIZATION}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --quantization ${SGLANG_QUANTIZATION}"
          fi
          if [ "${SGLANG_ENABLE_TORCH_COMPILE}" = "true" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --enable-torch-compile"
          fi
          # All three attention backends are UNSET by default, because the SGLang cookbook
          # pins no attention backend on any Blackwell cell -- B200, B300, GB200 and GB300
          # all rely on the engine's own dispatch. Only the Hopper cells (H100, H200) pin
          # --decode-attention-backend flashmla, which is why flashmla must never appear
          # here, and only the ROCm cells pin --attention-backend triton.
          # SGLang classifies KimiK3ForConditionalGeneration as AttentionArch.MLA (same
          # branch as KimiLinearForCausalLM in configs/model_config.py). Left unset, the
          # engine selects trtllm_mla for both phases -- it announces this at startup as
          # "Use trtllm_mla as the default prefill and decode attention backend for
          # Kimi-K3 on SM100/SM103", and the resolved server_args confirm
          # attention_backend, prefill_attention_backend and decode_attention_backend all
          # settle on trtllm_mla. (An earlier revision of this comment predicted
          # flashinfer; the running B200 deployment disproved it. flashinfer is what
          # sampling_backend resolves to, which is a different setting.)
          # Set these only with measurements in hand.
          if [ -n "${SGLANG_PREFILL_ATTENTION_BACKEND}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --prefill-attention-backend ${SGLANG_PREFILL_ATTENTION_BACKEND}"
          fi
          if [ -n "${SGLANG_DECODE_ATTENTION_BACKEND}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --decode-attention-backend ${SGLANG_DECODE_ATTENTION_BACKEND}"
          fi
          # KDA linear-attention prefill kernel for the 69 KDA layers. cutedsl is the
          # Blackwell CuteDSL kernel and SGLang admits it only for the MLA-hybrid family
          # (K3/KimiLinear), but the cookbook does not select it; engine default is triton.
          if [ -n "${SGLANG_LINEAR_ATTN_PREFILL_BACKEND}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --linear-attn-prefill-backend ${SGLANG_LINEAR_ATTN_PREFILL_BACKEND}"
          fi
          if [ -n "${SGLANG_REASONING_PARSER}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --reasoning-parser ${SGLANG_REASONING_PARSER}"
          fi
          if [ -n "${SGLANG_TOOL_CALL_PARSER}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --tool-call-parser ${SGLANG_TOOL_CALL_PARSER}"
          fi
          # MoE runner and KV-cache dtype are OFF by default. The SGLang cookbook's B200
          # 2-node cell sets neither; both appear only as opt-in overlays in the playground.
          # flashinfer_mxfp4 needs SGLANG_TRTLLM_GEN_MOE_CUBIN_POOL to point at a cubin
          # pool. The serving image already ships one: the Kimi-K3 image build downloads
          # trtllm_gen_moe_cubin_pool into /opt/trtllm_gen_moe_cubin_pool and bakes
          # SGLANG_TRTLLM_GEN_MOE_CUBIN_POOL into the image environment, so no staging
          # step is required here and none is provided.
          if [ -n "${SGLANG_MOE_RUNNER_BACKEND}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --moe-runner-backend ${SGLANG_MOE_RUNNER_BACKEND}"
          fi
          if [ -n "${SGLANG_KV_CACHE_DTYPE}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --kv-cache-dtype ${SGLANG_KV_CACHE_DTYPE}"
          fi
          # Hierarchical KV cache. OFF by default. When on with the "file" storage backend
          # the third tier lands on the node-local NVMe RAID mounted at
          # SGLANG_LOCAL_SCRATCH_MOUNT, which is why that array is mounted into this pod.
          #
          # The guard below is deliberately fatal rather than best-effort. The hostPath
          # volume uses DirectoryOrCreate, so if the local-nvme-raid-formatter DaemonSet
          # has not finished -- or found no NVMe devices at all -- kubelet silently hands
          # this container an empty directory on the boot disk. The engine would then run
          # a "hierarchical cache on NVMe" configuration entirely on the boot disk and
          # report perfectly plausible numbers, which is worse than not starting. The
          # DaemonSet touches .mounted only after the RAID is mounted, so its absence is
          # an unambiguous signal. Nothing else in this pod depends on the array, so the
          # check runs only when hierarchical caching is actually requested.
          if [ "${SGLANG_ENABLE_HIERARCHICAL_CACHE}" = "true" ]; then
            if [ ! -f "${SGLANG_LOCAL_SCRATCH_MOUNT}/.mounted" ]; then
              echo "FATAL: SGLANG_ENABLE_HIERARCHICAL_CACHE=true but ${SGLANG_LOCAL_SCRATCH_MOUNT}/.mounted is absent." >&2
              echo "       The local NVMe RAID is not mounted on this node, so the cache would silently land on the boot disk." >&2
              echo "       Check the local-nvme-raid-formatter DaemonSet in kube-system, then restart this pod." >&2
              exit 1
            fi
            # HiCacheFile creates its directory only on tp_rank 0, which lives on the
            # leader node. Every other rank expects the path to already exist, so create
            # it here on all ranks before the engine starts.
            mkdir -p "${SGLANG_LOCAL_SCRATCH_MOUNT}/hicache"
            # SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE is declared EnvStr(None) in SGLang's
            # environ.py, so "unset" and "set to empty" are different states to the engine:
            # unset means no cap, empty string is a value it would try to parse. The pod env
            # block always defines the variable, so drop it here when no cap was configured.
            if [ -z "${SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE}" ]; then
              unset SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE
            fi
            EXTRA_ARGS="${EXTRA_ARGS} --enable-hierarchical-cache"
            if [ -n "${SGLANG_HICACHE_STORAGE_BACKEND}" ]; then
              EXTRA_ARGS="${EXTRA_ARGS} --hicache-storage-backend ${SGLANG_HICACHE_STORAGE_BACKEND}"
            fi
            if [ -n "${SGLANG_HICACHE_SIZE}" ]; then
              EXTRA_ARGS="${EXTRA_ARGS} --hicache-size ${SGLANG_HICACHE_SIZE}"
            elif [ -n "${SGLANG_HICACHE_RATIO}" ]; then
              EXTRA_ARGS="${EXTRA_ARGS} --hicache-ratio ${SGLANG_HICACHE_RATIO}"
            fi
            if [ -n "${SGLANG_HICACHE_WRITE_POLICY}" ]; then
              EXTRA_ARGS="${EXTRA_ARGS} --hicache-write-policy ${SGLANG_HICACHE_WRITE_POLICY}"
            fi
            if [ -n "${SGLANG_HICACHE_IO_BACKEND}" ]; then
              EXTRA_ARGS="${EXTRA_ARGS} --hicache-io-backend ${SGLANG_HICACHE_IO_BACKEND}"
            fi
          fi
          # Both UNSET by default so the engine keeps its own defaults; the cookbook
          # pins neither. They exist because the saturation sweep produced two failure
          # signatures that these flags address directly, and neither was tunable:
          #   * TTFT P99 blew out to 94.5 s at 8k/c=128 while decode streams starved --
          #     the signature of prefill monopolising the scheduler. Lowering
          #     --chunked-prefill-size interleaves prefill chunks with decode steps.
          #   * Retraction appeared in exactly the cells where c * (ISL+OSL) exceeded
          #     the engine's reported max_total_num_tokens. Setting
          #     --max-running-requests to floor(max_total_num_tokens / (ISL+OSL))
          #     converts a retraction storm into clean admission queueing.
          # Set from measurement, not by default.
          if [ -n "${SGLANG_CHUNKED_PREFILL_SIZE}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --chunked-prefill-size ${SGLANG_CHUNKED_PREFILL_SIZE}"
          fi
          if [ -n "${SGLANG_MAX_RUNNING_REQUESTS}" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --max-running-requests ${SGLANG_MAX_RUNNING_REQUESTS}"
          fi
          # Required to make SGLANG_PARALLEL_PROFILE=tp8pp2 start at all on this stack.
          # TP16 spans both nodes, so SGLang disables its custom all-reduce and routes
          # every collective through NCCL. TP8 fits inside one node, which re-enables
          # the custom all-reduce path -- and that path registers its CUDA graph buffers
          # through CUDA IPC handles. On this pod configuration that registration fails
          # during decode graph capture:
          #   get_graph_buffer_ipc_meta -> custom_all_reduce.cuh:508
          #   Exception: Capture cuda graph failed: invalid argument
          # It is not memory pressure: it reproduces identically at
          # --mem-fraction-static 0.85 and 0.80, and /dev/shm is a 512Gi tmpfs.
          # Setting this falls back to NCCL for intra-node all-reduce and keeps CUDA
          # graphs enabled, which is the trade that matters -- disabling decode CUDA
          # graphs instead costs far more than custom all-reduce ever wins.
          if [ "${SGLANG_DISABLE_CUSTOM_ALL_REDUCE}" = "true" ]; then
            EXTRA_ARGS="${EXTRA_ARGS} --disable-custom-all-reduce"
          fi
          # DSPARK speculative decoding. OFF by default: the baseline this repository
          # publishes is a no-drafting TP16 run, and speculation must be measured
          # against it rather than folded into it silently.
          # Topology is unchanged -- 2 x A4 (16 x B200), TP16 -- which is the A4 variant
          # the Google Cloud day-0 write-up documents; the A4X/GB200 NVL72 variant it
          # prefers is explicitly out of scope here.
          # The draft checkpoint is NOT on the ROX volume. That disk is READ_ONLY_MANY
          # once hydrated, so the dspark-draft-fetch init container above rsyncs the
          # draft from GCS into node-local scratch and copies the base model's
          # generation_config.json in beside it. By the time this runs, that init
          # container has already succeeded -- so if the directory is missing here, the
          # cause is the mount, not the staging.
          if [ -n "${SGLANG_SPECULATIVE_ALGORITHM}" ]; then
            if [ ! -d "${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH}" ]; then
              echo "FATAL: SGLANG_SPECULATIVE_ALGORITHM=${SGLANG_SPECULATIVE_ALGORITHM} but draft model directory ${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH} is absent." >&2
              echo "       The dspark-draft-fetch init container stages this path; check its logs first:" >&2
              echo "         kubectl -n llm-serving logs $POD_NAME -c dspark-draft-fetch" >&2
              echo "       Confirm DSPARK_DRAFT_DIR_NAME is set and that prefix exists under the weights bucket." >&2
              exit 1
            fi
            if [ ! -f "${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH}/generation_config.json" ]; then
              echo "FATAL: ${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH}/generation_config.json is missing." >&2
              echo "       DSPARK requires the base model's generation_config.json to be copied into the draft directory." >&2
              exit 1
            fi
            EXTRA_ARGS="${EXTRA_ARGS} --speculative-algorithm ${SGLANG_SPECULATIVE_ALGORITHM}"
            EXTRA_ARGS="${EXTRA_ARGS} --speculative-draft-model-path ${SGLANG_SPECULATIVE_DRAFT_MODEL_PATH}"
            if [ -n "${SGLANG_SPECULATIVE_DSPARK_BLOCK_SIZE}" ]; then
              EXTRA_ARGS="${EXTRA_ARGS} --speculative-dspark-block-size ${SGLANG_SPECULATIVE_DSPARK_BLOCK_SIZE}"
            fi
            if [ "${SGLANG_ENABLE_LINEAR_REPLAYSSM_SPEC}" = "true" ]; then
              EXTRA_ARGS="${EXTRA_ARGS} --enable-linear-replayssm-spec"
            fi
          fi
          # DAY-0: drop --mem-fraction-static to 0.80 if OOM at ~94% of weight loading
          # DAY-0: --dcp-size deliberately NOT enabled. It is what the cookbook's B200
          # "balanced" and "high throughput" cells add on top of this "low latency" cell
          # (--dcp-size 16); we start from low latency. On our 2-node RoCEv2 fabric
          # (100 GB/s floor) DCP's per-decode-step collectives land on the critical path,
          # and only the 24 MLA layers hold the KV context it shards (69 KDA layers hold
          # fixed-size recurrent state).
          # Revisit only if first-deployment measurement shows decode is memory-bound rather than interconnect-bound.
          if [ -z "${SGLANG_PP_LAYER_PARTITION:-}" ]; then unset SGLANG_PP_LAYER_PARTITION; fi
          # Flags below track the SGLang Kimi-K3 cookbook's B200 / nnodes 2 cell:
          # https://docs.sglang.io/cookbook/autoregressive/Moonshotai/Kimi-K3
          #   --disable-flashinfer-autotune, --watchdog-timeout 3600 and
          #   --model-loader-extra-config are all prescribed there for this exact topology.
          # --dist-* and --nnodes/--node-rank are ours: multi-node loading of the 1.56 TB
          # checkpoint can exceed the default distributed-init timeout.
          # NOTE: comments must stay outside the backslash-continued command below --
          # a '#' on a continued line silently truncates the argv.
          exec python3 -m sglang.launch_server \
            --model-path /mnt/rox/Kimi-K3 \
            --served-model-name moonshotai/Kimi-K3 \
            --dist-init-addr "${LEADER_HOST}" \
            --dist-timeout 3600 \
            --nnodes 2 \
            --node-rank "${NODE_RANK}" \
            --port "${SGLANG_PORT}" \
            --host 0.0.0.0 \
            --trust-remote-code \
            --enable-metrics \
            --disable-flashinfer-autotune \
            --watchdog-timeout 3600 \
            --model-loader-extra-config '{"enable_multithread_load": true}' \
            --context-length "${SGLANG_CONTEXT_LENGTH}" \
            --tp-size "${SGLANG_TP_SIZE}" \
            --pp-size "${SGLANG_PP_SIZE}" \
            --ep-size "${SGLANG_EP_SIZE}" \
            --mem-fraction-static "${SGLANG_MEM_FRACTION_STATIC}" \
            --schedule-policy "${SGLANG_SCHEDULE_POLICY}" \
            ${EXTRA_ARGS}
        ports:
        - containerPort: 8000
          name: http
        - containerPort: 5000
          name: dist-init
        volumeMounts:
        - name: model-rox
          mountPath: /mnt/rox
          readOnly: true
        - name: dspark-draft
          mountPath: /mnt/draft
          readOnly: true
        - name: local-scratch
          mountPath: ${SGLANG_LOCAL_SCRATCH_MOUNT}
        - name: dshm
          mountPath: /dev/shm
        - name: nvidia-dir
          mountPath: /usr/local/nvidia
          readOnly: true
        - name: gib-dir
          mountPath: /usr/local/gib
          readOnly: true
        resources:
          requests:
            cpu: "32"
            memory: "768Gi"
          limits:
            memory: "1400Gi"
            nvidia.com/gpu: 8
      volumes:
      - name: model-rox
        persistentVolumeClaim:
          claimName: pvc-kimi-k3-weights-rox
      - name: dshm
        emptyDir:
          medium: Memory
          sizeLimit: 512Gi
      # Node-local scratch for the DSPARK draft. Disk-backed, not medium: Memory --
      # the draft is read once at load and then lives in VRAM, so spending 4 GiB of
      # host RAM on it would be waste. Stays empty when speculative decoding is off.
      #
      # hostPath on the NVMe RAID rather than an emptyDir. The node pool requests its
      # local SSDs through local_nvme_ssd_block_config, which is block mode: the disks
      # are handed to the node as raw devices and are NOT registered as kubelet
      # ephemeral storage. A disk-backed emptyDir therefore lands on the boot disk, not
      # on the array. Pointing the draft at the RAID mount is what actually moves it off
      # the boot disk. It also survives pod restarts on the same node, so the
      # dspark-draft-fetch rsync below is a no-op on a warm restart instead of a re-copy.
      - name: dspark-draft
        hostPath:
          path: ${SGLANG_HOST_SCRATCH_PATH}/dspark-draft
          type: DirectoryOrCreate
      # The RAID-0 array itself, built and mounted on the host by the
      # local-nvme-raid-formatter DaemonSet. Carries the hierarchical KV cache when
      # SGLANG_ENABLE_HIERARCHICAL_CACHE=true. DirectoryOrCreate keeps pod start
      # independent of the DaemonSet; the .mounted sentinel check in the launch wrapper
      # is what turns a missing array into a loud failure rather than a silent one.
      - name: local-scratch
        hostPath:
          path: ${SGLANG_HOST_SCRATCH_PATH}
          type: DirectoryOrCreate
      - name: nvidia-dir
        hostPath:
          path: /home/kubernetes/bin/nvidia
      - name: gib-dir
        hostPath:
          path: /home/kubernetes/bin/gib
