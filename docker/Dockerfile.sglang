# Pinned SGLang Blackwell container image for Kimi K3 MXFP4 multi-node serving
FROM lmsysorg/sglang:kimi-k3@sha256:6d9594a421be244f2af29d726158ebffe9c3c2b3f39b5b89affd8150a106e187

# Install fla-core for Kimi Delta Attention (KDA) linear-attention layers and hf_transfer
RUN pip install --no-cache-dir fla-core hf_transfer

LABEL org.opencontainers.image.title="Kimi K3 MXFP4 Sovereign SGLang Serving Runtime"
LABEL org.opencontainers.image.description="Multi-node RoCEv2 RDMA distributed inference engine for Kimi K3 (2.8T parameters)"
# Supports native multi-node PyTorch distributed coordination via --dist-init-addr (zero Ray dependencies)

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    openmpi-bin \
    libopenmpi-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir \
       mpi4py \
       requests \
       prometheus-client \
       "huggingface_hub[hf_transfer]>=0.26.0"

WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
